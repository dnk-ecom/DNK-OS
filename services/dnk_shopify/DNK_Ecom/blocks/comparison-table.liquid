{% doc %}
  Renders an Us vs. Them comparison table block highlighting brand superiority against traditional competitors.
{% enddoc %}

<div
  class="comparison-table-block block-spacing"
  style="
    --pt: {{ block.settings.pt | default: 20 | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | default: 20 | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h3 class="comparison-table-heading text-center fs-lg font-bold">
      {{ block.settings.heading }}
    </h3>
  {% endif %}

  <div class="comparison-table-wrapper">
    <table class="comparison-table">
      <thead>
        <tr>
          <th class="comparison-col-feature">{{ block.settings.feature_col_title | default: 'Features & Benefits' }}</th>
          <th class="comparison-col-us is-winner">
            <span class="comparison-brand-badge font-bold">{{ block.settings.brand_name | default: 'Our Brand' }}</span>
          </th>
          <th class="comparison-col-them">
            <span class="comparison-them-name">{{ block.settings.competitor_name | default: 'Other Brands' }}</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {% for i in (1..5) %}
          {% capture title_key %}feature_{{ i }}_title{% endcapture %}
          {% capture us_key %}feature_{{ i }}_us{% endcapture %}
          {% capture them_key %}feature_{{ i }}_them{% endcapture %}

          {% assign title = block.settings[title_key] %}
          {% assign us_val = block.settings[us_key] %}
          {% assign them_val = block.settings[them_key] %}

          {% if title != blank %}
            <tr>
              <td class="comparison-feature-name">{{ title }}</td>
              <td class="comparison-val comparison-val-us is-winner">
                {% if us_val %}
                  <span class="comparison-icon icon-check" aria-label="Yes">
                    {% render 'svg-icons', icon: 'check', icon_size: 16 %}
                  </span>
                {% else %}
                  <span class="comparison-icon icon-cross" aria-label="No">
                    {% render 'svg-icons', icon: 'close', icon_size: 16 %}
                  </span>
                {% endif %}
              </td>
              <td class="comparison-val comparison-val-them">
                {% if them_val %}
                  <span class="comparison-icon icon-check" aria-label="Yes">
                    {% render 'svg-icons', icon: 'check', icon_size: 16 %}
                  </span>
                {% else %}
                  <span class="comparison-icon icon-cross" aria-label="No">
                    {% render 'svg-icons', icon: 'close', icon_size: 16 %}
                  </span>
                {% endif %}
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

