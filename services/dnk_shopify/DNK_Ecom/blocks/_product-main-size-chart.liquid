{% doc %}
  Renders an interactive Size Guide modal with inches/centimeters dynamic unit switcher and measurement chart.
{% enddoc %}

{% liquid
  assign dialog_id = 'size-chart-dialog-' | append: block.id
%}

<size-chart
  class="size-chart block-spacing"
  data-size-chart
  style="
    --pt: {{ block.settings.pt | default: 5 | divided_by: 16.0 | append: 'em' }};
    --pb: {{ block.settings.pb | default: 10 | divided_by: 16.0 | append: 'em' }};
  "
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="size-chart-trigger-btn"
    data-dialog-trigger="{{ dialog_id }}"
    aria-haspopup="dialog"
  >
    {% render 'svg-icons', icon: 'ruler', icon_size: 16 %}
    <span>{{ block.settings.trigger_text | default: 'Size Guide' }}</span>
  </button>

  <theme-dialog>
    <dialog
      id="{{ dialog_id }}"
      class="dialog size-chart-dialog"
      aria-labelledby="{{ dialog_id }}-title"
    >
      <div class="dialog-header">
        <h2 id="{{ dialog_id }}-title" class="dialog-title fs-md font-bold">
          {{ block.settings.title | default: 'Size Guide & Measurements' }}
        </h2>

        <button
          class="icon-button dialog-close"
          type="button"
          data-dialog-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'svg-icons', icon: 'close' %}
        </button>
      </div>

      <div class="dialog-body size-chart-body">
        <!-- Units Toggle Switcher -->
        <div class="size-chart-units-toggle" data-unit-toggle>
          <span class="fs-xs font-bold">Units:</span>
          <div class="size-chart-toggle-pills">
            <button type="button" class="size-chart-pill is-active" data-unit="in">Inches (in)</button>
            <button type="button" class="size-chart-pill" data-unit="cm">Centimeters (cm)</button>
          </div>
        </div>

        <!-- Size Table -->
        <div class="size-chart-table-wrapper">
          <table class="size-chart-table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Bust/Chest</th>
                <th>Waist</th>
                <th>Hips</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-bold">XS</td>
                <td data-unit-in="32 - 34" data-unit-cm="81 - 86">32 - 34</td>
                <td data-unit-in="24 - 26" data-unit-cm="61 - 66">24 - 26</td>
                <td data-unit-in="34 - 36" data-unit-cm="86 - 91">34 - 36</td>
              </tr>
              <tr>
                <td class="font-bold">S</td>
                <td data-unit-in="35 - 37" data-unit-cm="89 - 94">35 - 37</td>
                <td data-unit-in="27 - 29" data-unit-cm="69 - 74">27 - 29</td>
                <td data-unit-in="37 - 39" data-unit-cm="94 - 99">37 - 39</td>
              </tr>
              <tr>
                <td class="font-bold">M</td>
                <td data-unit-in="38 - 40" data-unit-cm="97 - 102">38 - 40</td>
                <td data-unit-in="30 - 32" data-unit-cm="76 - 81">30 - 32</td>
                <td data-unit-in="40 - 42" data-unit-cm="102 - 107">40 - 42</td>
              </tr>
              <tr>
                <td class="font-bold">L</td>
                <td data-unit-in="41 - 43" data-unit-cm="104 - 109">41 - 43</td>
                <td data-unit-in="33 - 35" data-unit-cm="84 - 89">33 - 35</td>
                <td data-unit-in="43 - 45" data-unit-cm="109 - 114">43 - 45</td>
              </tr>
              <tr>
                <td class="font-bold">XL</td>
                <td data-unit-in="44 - 46" data-unit-cm="112 - 117">44 - 46</td>
                <td data-unit-in="36 - 38" data-unit-cm="91 - 97">36 - 38</td>
                <td data-unit-in="46 - 48" data-unit-cm="117 - 122">46 - 48</td>
              </tr>
              <tr>
                <td class="font-bold">2XL</td>
                <td data-unit-in="47 - 50" data-unit-cm="119 - 127">47 - 50</td>
                <td data-unit-in="39 - 42" data-unit-cm="99 - 107">39 - 42</td>
                <td data-unit-in="49 - 52" data-unit-cm="124 - 132">49 - 52</td>
              </tr>
            </tbody>
          </table>
        </div>

        {% if block.settings.tip != blank %}
          <div class="size-chart-tip alert alert-info fs-xs">
            {% render 'svg-icons', icon: 'info', icon_size: 14 %}
            <span>{{ block.settings.tip }}</span>
          </div>
        {% endif %}
      </div>
    </dialog>
  </theme-dialog>
</size-chart>

{% schema %}
{
  "name": "Size chart",
  "settings": [
    {
      "type": "text",
      "id": "trigger_text",
      "label": "Trigger link text",
      "default": "Size Guide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Modal title",
      "default": "Size Guide & Measurements"
    },
    {
      "type": "text",
      "id": "tip",
      "label": "Measurement tip",
      "default": "Tip: If you fall between two sizes, we recommend ordering the larger size for a relaxed fit."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Size chart",
      "category": "Product"
    }
  ]
}
{% endschema %}
