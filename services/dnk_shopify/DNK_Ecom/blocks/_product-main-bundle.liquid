{% doc %}
  Renders a zero-app Frequently Bought Together / Bundle Builder block directly on the product details page.
{% enddoc %}

{% liquid
  assign current_product = closest.product | default: product
  assign product_1 = block.settings.bundle_product_1
  assign product_2 = block.settings.bundle_product_2
  assign bundle_discount = block.settings.bundle_discount | default: 15

  assign current_variant = current_product.selected_or_first_available_variant
  assign p1_variant = product_1.selected_or_first_available_variant
  assign p2_variant = product_2.selected_or_first_available_variant

  assign raw_total = current_variant.price
  if product_1 != blank and p1_variant.available
    assign raw_total = raw_total | plus: p1_variant.price
  endif
  if product_2 != blank and p2_variant.available
    assign raw_total = raw_total | plus: p2_variant.price
  endif

  assign discount_multiplier = 100 | minus: bundle_discount | divided_by: 100.0
  assign bundle_price = raw_total | times: discount_multiplier | round
  assign savings = raw_total | minus: bundle_price
%}

{% if current_product != blank and product_1 != blank %}
  <bundle-builder
    class="bundle-builder block-spacing"
    data-bundle-builder
    data-discount="{{ bundle_discount }}"
    style="
      --pt: {{ block.settings.pt | default: 15 | divided_by: 16.0 | append: 'em' }};
      --pb: {{ block.settings.pb | default: 25 | divided_by: 16.0 | append: 'em' }};
    "
    {{ block.shopify_attributes }}
  >
    <div class="bundle-builder-header">
      <h3 class="bundle-builder-title fs-sm font-bold">
        {{ block.settings.heading | default: 'Frequently Bought Together' }}
      </h3>
      {% if bundle_discount > 0 %}
        <span class="bundle-badge badge-sale">Save {{ bundle_discount }}% ({{ savings | money }})</span>
      {% endif %}
    </div>

    <!-- Product Thumbnails Row -->
    <div class="bundle-products-visual">
      <!-- Item 0: Main Product -->
      <div class="bundle-product-item">
        <div class="bundle-thumb-wrapper">
          {% if current_product.featured_image %}
            {{
              current_product.featured_image
              | image_url: width: 140
              | image_tag:
                widths: '70, 140',
                sizes: '70px',
                loading: 'lazy',
                class: 'bundle-thumb-img',
                alt: current_product.title
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>

      <span class="bundle-plus-icon">+</span>

      <!-- Item 1: Bundle Product 1 -->
      <div class="bundle-product-item">
        <div class="bundle-thumb-wrapper">
          {% if product_1.featured_image %}
            {{
              product_1.featured_image
              | image_url: width: 140
              | image_tag:
                widths: '70, 140',
                sizes: '70px',
                loading: 'lazy',
                class: 'bundle-thumb-img',
                alt: product_1.title
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>

      {% if product_2 != blank and p2_variant.available %}
        <span class="bundle-plus-icon">+</span>

        <!-- Item 2: Bundle Product 2 -->
        <div class="bundle-product-item">
          <div class="bundle-thumb-wrapper">
            {% if product_2.featured_image %}
              {{
                product_2.featured_image
                | image_url: width: 140
                | image_tag:
                  widths: '70, 140',
                  sizes: '70px',
                  loading: 'lazy',
                  class: 'bundle-thumb-img',
                  alt: product_2.title
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Checkboxes & Item Details -->
    <div class="bundle-checkboxes">
      <label class="bundle-checkbox-label fs-xs">
        <input type="checkbox" checked disabled data-bundle-input value="{{ current_variant.id }}" data-price="{{ current_variant.price }}">
        <span class="bundle-item-desc">
          <strong>This item:</strong> {{ current_product.title }} ({{ current_variant.price | money }})
        </span>
      </label>

      <label class="bundle-checkbox-label fs-xs">
        <input type="checkbox" checked data-bundle-input value="{{ p1_variant.id }}" data-price="{{ p1_variant.price }}">
        <span class="bundle-item-desc">
          {{ product_1.title }} ({{ p1_variant.price | money }})
        </span>
      </label>

      {% if product_2 != blank and p2_variant.available %}
        <label class="bundle-checkbox-label fs-xs">
          <input type="checkbox" checked data-bundle-input value="{{ p2_variant.id }}" data-price="{{ p2_variant.price }}">
          <span class="bundle-item-desc">
            {{ product_2.title }} ({{ p2_variant.price | money }})
          </span>
        </label>
      {% endif %}
    </div>

    <!-- Bundle Total & Action Button -->
    <div class="bundle-footer">
      <div class="bundle-price-box">
        <span class="bundle-price-total font-bold fs-md" data-bundle-total>{{ bundle_price | money }}</span>
        <s class="bundle-price-compare fs-xs" data-bundle-compare>{{ raw_total | money }}</s>
      </div>

      <button
        type="button"
        class="btn btn-primary btn-sm bundle-add-button"
        data-bundle-submit
      >
        {% render 'svg-icons', icon: 'bag', icon_size: 16 %}
        <span>Add Bundle to Cart</span>
      </button>
    </div>
  </bundle-builder>
{% endif %}

{% schema %}
{
  "name": "Bundle builder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "product",
      "id": "bundle_product_1",
      "label": "Bundle product 1"
    },
    {
      "type": "product",
      "id": "bundle_product_2",
      "label": "Bundle product 2"
    },
    {
      "type": "range",
      "id": "bundle_discount",
      "label": "Bundle discount %",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 15
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pt",
      "label": "Top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "pb",
      "label": "Bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Bundle builder",
      "category": "Product"
    }
  ]
}
{% endschema %}
