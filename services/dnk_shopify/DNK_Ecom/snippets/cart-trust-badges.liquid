{% doc %}
  Renders security trust badges and reassurance icons below checkout button.
{% enddoc %}

{% if settings.cart_show_trust_badges %}
  <div class="cart-trust-badges">
    <div class="cart-trust-header">
      {% render 'svg-icons', icon: 'lock', icon_size: 14 %}
      <span>{{ 'cart.trust_badges.secure_checkout' | t }}</span>
    </div>

    <div class="cart-trust-icons">
      {% if settings.cart_trust_badge_svg != blank %}
        <img
          src="{{ settings.cart_trust_badge_svg | image_url: width: 400 }}"
          alt="{{ 'cart.trust_badges.payment_methods' | t }}"
          loading="lazy"
          width="200"
          height="30"
          class="cart-trust-custom-img"
        >
      {% else %}
        <span class="cart-trust-pill">
          {% render 'svg-icons', icon: 'shield', icon_size: 14 %}
          <span>{{ 'cart.trust_badges.ssl_encrypted' | t }}</span>
        </span>
        <span class="cart-trust-pill">
          {% render 'svg-icons', icon: 'refresh', icon_size: 14 %}
          <span>{{ 'cart.trust_badges.easy_returns' | t }}</span>
        </span>
      {% endif %}
    </div>
  </div>
{% endif %}
