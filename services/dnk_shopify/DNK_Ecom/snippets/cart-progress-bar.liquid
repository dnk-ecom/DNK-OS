{%- comment -%}
  Progress bar (blocks/cart_progress-bar.liquid).
  Accepts:
  - block: the Progress bar block
  - items_count: the cart's item count without cart-hidden products
  - bar_style {String} the resolved Bar style: line_icons (today's look), steps, minimal, status, text (default line_icons)
  - in_drawer {Boolean} rendered inside the cart drawer (the style CSS then loads through the cart core)
  - override {String} theme editor only: "Progress bar|Bar style" when the block overrides the cart style
{%- endcomment -%}
{% liquid
  assign is_quantity = false
  if block.settings.goal_type == 'quantity'
    assign is_quantity = true
  endif

  if is_quantity
    assign goal_multiplier = 1.0
    assign goal_max_reference = items_count
  else
    assign goal_multiplier = 100.00
    assign goal_max_reference = cart.total_price
  endif

  # A blank goal uses the free shipping goal of Theme settings > Cart (subtotal goals only). That goal is counted on
  # the free shipping basis shared with the Rewards bar and Subtotals: items that don't ship, gifts and cart-hidden
  # products leave it out, and it is reached only once a counted item is in the cart. A goal of 0 is reached.
  assign pb_kind = 'shop'
  assign pb_hidden = false
  assign pb_sample = false
  assign pb_theme_goal = false
  assign pb_counted_items = 1
  assign pb_total_cents = cart.total_price
  if block.settings.goal != blank
    assign goal = block.settings.goal | times: goal_multiplier
  elsif is_quantity
    assign pb_hidden = true
    assign goal = 0
  else
    capture pb_fsg
      render 'cart-free-shipping-goal'
    endcapture
    assign pb_g = pb_fsg | strip | split: '|'
    assign pb_kind = pb_g[0]
    if pb_kind == 'none'
      assign pb_kind = 'shop'
      assign pb_hidden = true
      assign goal = 0
    else
      assign goal = pb_g[1] | times: 1.0
      assign pb_theme_goal = true
      capture pb_counted
        render 'cart-goal-total', skip_unshipped: true
      endcapture
      assign pb_c = pb_counted | strip | split: '|'
      assign goal_max_reference = pb_c[0] | plus: 0
      assign pb_counted_items = pb_c[1] | plus: 0
      assign pb_total_cents = goal_max_reference
    endif
  endif
  if pb_hidden and request.design_mode
    # theme editor only: a sample goal, so the merchant sees the bar next to the notice
    assign pb_sample = true
    if is_quantity
      assign goal = 3.0
    else
      assign goal = 5000.0
    endif
  endif

  if goal > 0
    assign goal_progress = goal_max_reference | divided_by: goal | times: 100.0
  else
    assign goal_progress = 100.0
  endif
  if pb_theme_goal and pb_counted_items == 0
    assign goal_progress = 0
  endif

  assign sub_auto_complete = false
  if block.settings.sub_auto_complete
    for item in cart.items
      if item.selling_plan_allocation
        assign sub_auto_complete = true
        break
      endif
    endfor
  endif
  assign goal_reached = false
  if goal_progress >= 100.00 or sub_auto_complete
    assign goal_reached = true
    assign goal_progress = 100
  endif

  assign icon_size = block.settings.icon_size | divided_by: 10.0
  assign icon_scale = block.settings.icon_scale | divided_by: 100.0
  assign icon_corner_radius = block.settings.icon_corner_radius | divided_by: 2.0
  assign border_thickness = block.settings.border_thickness | divided_by: 10.0
  assign line_height = block.settings.line_height | divided_by: 10.0

  # Bar style (Same as cart is resolved by the block): line_icons is today's markup exactly
  assign pb_style = bar_style | default: 'line_icons'
  assign pb_align = block.settings.text_alignment | default: 'center'
%}

{% capture goal_difference_html %}
  {% if is_quantity %}
    {{ goal | minus: items_count | round }}
  {% else %}
    <span>{{ goal | minus: goal_max_reference | money_without_trailing_zeros }}</span>
  {% endif %}
{% endcapture %}
{%- if pb_hidden and pb_sample == false -%}
  {%- comment -%} No goal applies (T11): customers see nothing. {%- endcomment -%}
{%- else -%}
{%- if pb_sample -%}
  {%- if is_quantity -%}
    {% render 'cart-editor-notice', code: 'rewards-progress-no-goal', level: 'warning', title: 'Progress bar', text: "no goal is set, so customers don't see the bar. Set a goal. The preview uses a sample goal." %}
  {%- else -%}
    {% render 'cart-editor-notice', code: 'rewards-progress-no-goal', level: 'warning', title: 'Progress bar', text: "no goal is set, so customers don't see the bar. Set a goal, or the free shipping goal in Theme settings > Cart. The preview uses a sample goal." %}
  {%- endif -%}
{%- endif -%}

<style>
  .cart-progress-{{ block.id }} {
    margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;
    margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;
  }
  .cart-progress-{{ block.id }} .cart-progress__bar {
    height: {{ line_height }}rem;
  }
  .cart-progress-{{ block.id }} .cart-progress__bar__badge {
    width: {{ icon_size }}rem;
    height: {{ icon_size }}rem;
    border-radius: {{ icon_corner_radius }}%;
    {% if block.settings.border_thickness > 0 %}
      border: {{ border_thickness }}rem {{ block.settings.border_style }} {% if block.settings.border_color == 'custom' %}{{ block.settings.border_custom_color }}{% else %}rgb(var(--color-base-{{ block.settings.border_color }})){% endif %};
    {% endif %}
    {% if block.settings.icon_bg == 'custom_color' %}
      background: {{ block.settings.icon_bg_color }};
    {% elsif block.settings.icon_bg == 'gradient' %}
      background: {{ block.settings.icon_bg_gradient }};
    {% else %}
      background: rgb(var(--color-base-{{ block.settings.icon_bg }}));
    {% endif %}
  }
  .cart-progress-{{ block.id }} .cart-progress__bar__badge .material-symbols-outlined,
  .cart-progress-{{ block.id }} .cart-progress__bar__badge img {
    font-size: calc({{ icon_size }}rem * {{ icon_scale }});
    width: calc({{ icon_size }}rem * {{ icon_scale }});
    height: calc({{ icon_size }}rem * {{ icon_scale }});
    {% if block.settings.icon_color == 'custom' %}
      color: {{ block.settings.icon_custom_color }};
    {% else %}
      color: rgb(var(--accent-color));
    {% endif %}
  }
  {% if block.settings.icon_type == 'dot' %}
    .cart-progress-{{ block.id }} .cart-progress__bar__badge::before {
      content: '';
      display: block;
      width: calc({{ icon_size }}rem * {{ icon_scale }});
      height: calc({{ icon_size }}rem * {{ icon_scale }});
      border-radius: 50%;
      flex-shrink: 0;
      {% if block.settings.icon_color == 'custom' %}
        background: {{ block.settings.icon_custom_color }};
      {% else %}
        background: rgb(var(--accent-color));
      {% endif %}
    }
  {% endif %}
  .cart-progress-{{ block.id }} .cart-progress__bar__progress {
    {% unless block.settings.display_stripes %}
      background-image: none !important;
      animation: none !important;
    {% endunless %}
    {% if block.settings.line_color == 'custom_color' %}
      background-color: {{ block.settings.line_custom_color }} !important;
    {% elsif block.settings.line_color == 'gradient' %}
      background: {{ block.settings.line_gradient }} !important;
    {% endif %}
  }
</style>

{%- capture pb_icon_html -%}
  {% if block.settings.icon_type == 'custom_icon' and block.settings.custom_icon != blank %}
    <img
      src="{{ block.settings.custom_icon | image_url }}"
      {% if block.settings.custom_icon.alt != blank %}
        alt="{{ block.settings.custom_icon.alt | escape }}"
      {% else %}
        role="presentation"
      {% endif %}
      height="200"
      width="200"
      loading="lazy"
    >
  {% elsif block.settings.icon_type == 'icon' and block.settings.icon != blank %}
    <span class="material-symbols-outlined{% if block.settings.icon_filled %} filled{% endif %}">
      {{ block.settings.icon | strip | downcase | replace: ' ', '_' }}
    </span>
  {% elsif block.settings.icon_type == 'dot' %}
    {%- comment -%}Dot is rendered via CSS pseudo-element{%- endcomment -%}
  {% endif %}
{%- endcapture -%}
{%- capture pb_text_html -%}
  <p class="cart-progress__text" id="CartProgress-{{ block.id }}-text"{% if pb_align != 'center' %} style="text-align: {{ pb_align }}"{% endif %}>
    {% if goal_reached == false %}
      {{ block.settings.progress_message | replace: '[amount]', goal_difference_html }}
    {% else %}
      {{ block.settings.success_message }}
    {% endif %}
  </p>
{%- endcapture -%}
{%- if pb_style != 'line_icons' and in_drawer != true -%}
  {{ 'component-cart-rewards.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<cart-progress-bar
  class="cart-progress cart-progress-{{ block.id }} {% if block.settings.icon_color != 'custom' %}accent-color-{{ block.settings.icon_color }}{% endif %}{% if pb_style != 'line_icons' %} cart-progress--{{ pb_style }}{% endif %}"
  data-is-quantity="{{ is_quantity }}"
  data-shop-currency="{{ shop.currency }}"
  data-goal-shop-cents="{{ goal }}"
  data-cart-total-cents="{{ pb_total_cents }}"
  data-sub-auto-complete="{{ sub_auto_complete }}"
  data-progress-message="{{ block.settings.progress_message | escape }}"
  data-success-message="{{ block.settings.success_message | escape }}"
  data-block-id="{{ block.id }}"
  data-goal-kind="{{ pb_kind }}"
  data-bar-style="{{ pb_style }}"
  {%- if pb_theme_goal %} data-counted-items="{{ pb_counted_items }}"{% endif %}
  {%- if pb_style != 'line_icons' and in_drawer %} data-cart-feature="rewards:css"{% endif %}
  {%- if override != blank and request.design_mode %} data-cart-override="{{ override | escape }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {%- case pb_style -%}
    {%- when 'status' -%}
      {%- liquid
        if goal_reached
          assign pb_status = 'sections.cart.rewards_status_unlocked' | t
        else
          if is_quantity
            assign pb_left = goal | minus: items_count | round | at_least: 0
          else
            assign pb_left = goal | minus: goal_max_reference | at_least: 0 | money_without_trailing_zeros | strip_html
          endif
          assign pb_status = 'sections.cart.rewards_status_locked' | t: amount: pb_left
        endif
      -%}
      <div class="cart-progress__row">
        <span class="cart-progress__bar__badge cart-progress__row-icon" aria-hidden="true">{{ pb_icon_html }}</span>
        {{ pb_text_html }}
        <span class="cart-progress__status{% if goal_reached %} is-reached{% endif %}">{{ pb_status }}</span>
      </div>
    {%- when 'text' -%}
      {{ pb_text_html }}
    {%- else -%}
      {{ pb_text_html }}
      <div class="cart-progress__bar" role="progressbar" aria-labelledby="CartProgress-{{ block.id }}-text" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ goal_progress | round }}">
        <div class="cart-progress__bar__progress {% if block.settings.line_color != 'custom_color' and block.settings.line_color != 'gradient' %}accent-color-{{ block.settings.line_color }}{% endif %}{% if block.settings.display_stripes %} cart-progress__bar__progress--striped{% endif %}" style="width: {{ goal_progress }}%;">
          {%- if pb_style == 'line_icons' -%}
            <div class="cart-progress__bar__badge">
              {{ pb_icon_html }}
            </div>
          {%- else -%}
            &nbsp;
          {%- endif -%}
        </div>
        {%- if pb_style == 'steps' -%}
          <span class="cart-progress__bar__badge cart-progress__end{% if goal_reached %} is-reached{% endif %}" aria-hidden="true">
            {{- pb_icon_html -}}
            <svg class="cart-progress__check" viewBox="0 0 12 9" focusable="false" aria-hidden="true"><path d="M1 4.6l3.1 3.1L11 1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        {%- endif -%}
      </div>
  {%- endcase -%}
</cart-progress-bar>
{%- endif -%}
