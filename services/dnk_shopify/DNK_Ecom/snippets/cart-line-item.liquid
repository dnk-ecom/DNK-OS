{%- comment -%}
  One cart line for the cart drawer (Cart items) and Cart page V2's items.
  Accepts:
  - item: the line item; index: its 1-based position
  - opts: the host's settings (Cart items or Cart page V2's items; the same ids). Never passed as `settings`:
    that name would hide the theme settings this markup reads.
  - cart_style: the section's cart style (for the Subscribe & save control)
  - context: 'drawer' (CartDrawer-* ids) or 'page' (Cart page V2, CartPage-* ids)
  - scope: block id (ids other than line ids)
  - parent_keys: '|key|key|' of the lines that have nested children (computed once by the host)
  - hidden_qty_ids: '|id|id|' of the products whose quantity selector is hidden (computed once by the host)
  - item_style, image_ratio, savings_style, free_item_style: values resolved once by the host through cart-style-value
  - sub: this line's cart-subscription-eligibility output, blank when Subscribe & save is off
  - sub_sample: true on the line that shows the editor's sample Subscribe & save control
  Usage:
  {% render 'cart-line-item', item: item, index: forloop.index, opts: block.settings, cart_style: section.settings.cart_style, context: 'drawer', scope: block.id, parent_keys: parent_keys, hidden_qty_ids: quantity_hidden_ids, item_style: item_style, image_ratio: image_ratio, savings_style: savings_style, free_item_style: free_item_style, sub: sub, sub_sample: false %}
{%- endcomment -%}
{%- liquid
  assign line = index
  assign id_prefix = 'CartDrawer'
  assign qty_prefix = 'Drawer'
  assign surface_name = 'drawer'
  if context == 'page'
    assign id_prefix = 'CartPage'
    assign qty_prefix = 'CartPage'
    assign surface_name = 'page-v2'
  endif
  # Quantity breaks V2 adds nested gift and add-on lines with a _qb_ property; other apps' nested lines look as before
  assign qb_nested = false
  if item.parent_relationship
    if item.properties['_qb_gift'] != blank or item.properties['_qb_upsell'] != blank or item.properties['_qb_bundle'] != blank
      assign qb_nested = true
    endif
  endif
  assign is_qb = false
  if item.properties['_qb_gift'] != blank or item.properties['_qb_upsell'] != blank or item.properties['_qb_bundle'] != blank
    assign is_qb = true
  endif
  assign is_free = false
  if item.final_line_price == 0
    assign is_free = true
  endif
  assign key_token = '|' | append: item.key | append: '|'
  assign is_parent = false
  if parent_keys contains key_token
    assign is_parent = true
  endif
  # nested lines from other apps can forbid removing or changing them (line_item.instructions); ordinary lines report nil or true
  assign no_remove = false
  if item.instructions.can_remove == false
    assign no_remove = true
  endif
  assign no_quantity = false
  if item.instructions.can_update_quantity == false
    assign no_quantity = true
  endif
  assign hide_quantity = false
  assign product_id_key = '|' | append: item.product.id | append: '|'
  if hidden_qty_ids contains product_id_key or no_quantity
    assign hide_quantity = true
  endif

  # data-line-flags, space-separated, in this order (the free, nested, qb, qb-gift and reward-gift tokens are read by main.js)
  assign flags = ''
  if is_free
    assign flags = flags | append: ' free'
  endif
  if item.gift_card
    assign flags = flags | append: ' gift-card'
  endif
  if item.item_components.size > 0
    assign flags = flags | append: ' bundle'
  endif
  if item.parent_relationship
    assign flags = flags | append: ' nested'
  endif
  if is_parent
    assign flags = flags | append: ' parent'
  endif
  if is_qb
    assign flags = flags | append: ' qb'
  endif
  if item.properties['_qb_gift'] != blank
    assign flags = flags | append: ' qb-gift'
  endif
  if item.properties['_reward_gift'] != blank
    assign flags = flags | append: ' reward-gift'
  endif
  if item.selling_plan_allocation
    assign flags = flags | append: ' plan'
  endif
  if item.variant.requires_selling_plan
    assign flags = flags | append: ' requires-plan'
  endif
  if item.product.tags contains 'cart-hidden'
    assign flags = flags | append: ' cart-hidden'
  endif
  if no_remove
    assign flags = flags | append: ' no-remove'
  endif
  if no_quantity
    assign flags = flags | append: ' no-quantity'
  endif
  assign flags = flags | strip

  # a line the cart's scripts act on (undo, save for later, variant change, subscribe): plain lines only
  assign plain_line = true
  if is_free or item.gift_card or item.item_components.size > 0 or item.parent_relationship or is_parent or is_qb or item.properties['_reward_gift'] != blank or item.product.tags contains 'cart-hidden' or no_remove
    assign plain_line = false
  endif
  assign save_later = false
  if opts.show_save_for_later and settings.wishlist_enable and plain_line
    assign save_later = true
  endif
  assign variant_change = false
  if opts.enable_variant_change and plain_line and no_quantity == false and item.product.has_only_default_variant == false
    assign variant_change = true
  endif
  assign line_data = false
  if opts.enable_undo or save_later or variant_change or opts.show_subscribe_save
    assign line_data = true
  endif
-%}
<li
  id="{{ id_prefix }}-Item-{{ line }}"
  class="cart-drawer-item cart-item cart-item--product-{{ item.product.handle }}{% if item.properties['_qb_gift'] != blank %} cart-item--qb-gift{% endif %}{% if qb_nested %} cart-item--qb-nested{% endif %}{% if item.properties['_reward_gift'] != blank %} cart-item--reward-gift{% endif %}{% if is_free %} cart-item--free{% endif %}{% if item.selling_plan_allocation %} cart-item--subscribed{% endif %}{% if context == 'page' %} cart-line--page{% endif %}"
  data-index="{{ line }}"
  data-quantity="{{ item.quantity }}"
  data-variant-options="{{ item.variant.options | join: '|||' | downcase }}"
  data-line-key="{{ item.key }}"
  data-variant-id="{{ item.variant_id }}"
  data-product-id="{{ item.product_id }}"
  data-handle="{{ item.product.handle }}"
  data-selling-plan="{{ item.selling_plan_allocation.selling_plan.id }}"
  data-line-price="{{ item.final_line_price }}"
  data-line-flags="{{ flags }}"
  {%- if line_data %}
    data-title="{{ item.product.title | escape }}"
    data-properties="{{ item.properties | json | escape }}"
  {%- endif %}
>
  <div class="loading-overlay hidden">
    <div class="loading-overlay__spinner">
      <svg
        aria-hidden="true"
        focusable="false"
        class="spinner"
        viewBox="0 0 66 66"
        xmlns="http://www.w3.org/2000/svg"
      >
        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
      </svg>
    </div>
  </div>
  <div class="cart-item__media">
    {% if item.image %}
      {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
      {% if opts.image_link %}<a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>{% endif %}
      <img
        class="cart-item__image"
        src="{{ item.image | image_url: width: 300 }}"
        alt="{{ item.image.alt | escape }}"
        loading="lazy"
        width="150"
        height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
      >
    {% endif %}
  </div>

  <div class='cart-drawer-item__right'>
    {% liquid
      assign has_props = false
      capture compare_capture
        render 'cart-line-compare-price', item: item, mode: opts.displayed_compare_prices, include_plan: opts.include_subscription_savings
      endcapture
      assign compare_price = compare_capture | strip | plus: 0
      assign display_compare = false
      if compare_price > 0
        assign display_compare = true
      endif
    %}
    <div class='cart-drawer-item__details-and-delete-btn'>
      <div class="cart-item__details">
        {%- if settings.show_vendor -%}
          <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
        {%- endif -%}

        <{% if opts.title_link %}a href="{{ item.url }}"{% else %}h3{% endif %} class="cart-item__name h4 break">
          {{- item.product.title | escape -}}
          {%- if item.item_components.size > 0 and opts.bundle_title_suffix != blank -%}
            <span class="cart-item__bundle-suffix">&nbsp;{{ opts.bundle_title_suffix }}</span>
          {%- endif -%}
        </{% if opts.title_link %}a{% else %}h3{% endif %}>

        {%- comment -%} Quantity breaks V2 lines: gift / bundle / nested add-on caption {%- endcomment -%}
        {%- if item.properties['_qb_gift'] != blank -%}
          <p class="cart-item__qb-caption cart-item__qb-caption--gift"><svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 16 16"><path d="M2 7h12v2H2zM3 9h10v5H3zM8 7v7M8 7C6 7 4.5 5.5 5.5 4.5S8 5 8 7zm0 0c2 0 3.5-1.5 2.5-2.5S8 5 8 7z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg><span>{{ item.properties['_qb_gift'] | escape }}</span></p>
        {%- elsif item.properties['_qb_bundle'] != blank -%}
          <p class="cart-item__qb-caption"><svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>{{ item.properties['_qb_bundle'] | escape }}</span></p>
        {%- elsif qb_nested -%}
          <p class="cart-item__qb-caption"><svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 16 16"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>{{ item.parent_relationship.parent.product.title | escape }}</span></p>
        {%- endif -%}

        {%- comment -%} Free tag (Highlight free items style; Quantity breaks gift lines already have their caption) {%- endcomment -%}
        {%- if free_item_style == 'highlight' and is_free and item.properties['_qb_gift'] == blank and opts.free_item_tag != blank -%}
          <span class="badge cart-line-tag color-{{ settings.sale_badge_color_scheme }}">{{ opts.free_item_tag | escape }}</span>
        {%- endif -%}
        {%- comment -%} Badge from a product metafield (namespace.key) {%- endcomment -%}
        {%- if opts.badge_metafield != blank and opts.badge_metafield contains '.' -%}
          {%- liquid
            assign mf_parts = opts.badge_metafield | strip | split: '.'
            assign mf = item.product.metafields[mf_parts[0]][mf_parts[1]]
            assign mf_text = mf.value
            if mf.type contains 'list.'
              assign mf_text = mf.value | join: ', '
            endif
          -%}
          {%- if mf_text != blank -%}<span class="cart-line-badge">{{ mf_text | escape }}</span>{%- endif -%}
        {%- endif -%}

        {%- if item.original_price != item.final_price -%}
          {% for discount in item.discounts %}
            {% capture discount_html %}
              <div class="badge">
                {%- render 'icon-discount' -%}
                <span>{{ discount.title }} (-{{ item.original_price | minus: item.final_price | money }})</span>
              </div>
            {% endcapture %}
            {% liquid
              if product_discounts_number > 0
                assign product_discounts = product_discounts | append: 'DIVIDER'
              endif
              assign product_discounts_number = product_discounts_number | plus: 1
              assign product_discounts = product_discounts | append: discount_html
            %}
          {% endfor %}
          {% if opts.display_single_item_prices %}
            {% assign has_props = true %}
            <div class="cart-item__discounted-prices cart-drawer-item__single-item-prices">
              <span>
                <span class="visually-hidden">
                  {{ 'products.product.price.regular_price' | t }}
                </span>
                <s class="cart-item__old-price product-option text-color-{{ opts.compare_price_color }}">
                  {{- compare_price | divided_by: item.quantity | money -}}
                </s>
                <span class="visually-hidden">
                  {{ 'products.product.price.sale_price' | t }}
                </span>
                <strong class="cart-item__final-price product-option text-color-{{ opts.price_color }}">
                  {% if opts.free_prices_text != blank and item.final_price == 0 %}
                    {{ opts.free_prices_text }}
                  {% else %}
                    {{ item.final_price | money }}
                  {% endif %}
                </strong>
              </span>
              <div class="cart-drawer__discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for allocation in item.line_level_discount_allocations -%}
                  <div class="badge" role="listitem">
                    {%- render 'icon-discount' -%}
                    <span>{{ allocation.discount_application.title }}</span>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if item.product.has_only_default_variant == false
          or item.properties != blank
          or item.selling_plan_allocation != null
        -%}
          {% assign has_props = true %}
          {%- if variant_change -%}
            <cart-line-variant class="cart-line-variant" data-cart-feature="lines" data-handle="{{ item.product.handle }}" data-variant-id="{{ item.variant_id }}" data-unavailable="{{ 'products.product.variant_sold_out_or_unavailable' | t | escape }}">
              {%- for option in item.product.options_with_values -%}
                {%- assign current_value = item.options_with_values[forloop.index0].value -%}
                <div class="cart-line-variant__option select select--small no-background color-{{ settings.pickers_color_scheme }} accent-color-{{ settings.pickers_overlay_color }} accent-2-color-{{ settings.pickers_text_color }}">
                  <select class="select__select" data-option-index="{{ forloop.index0 }}" aria-label="{{ 'sections.cart.lines_variant_label' | t: option: option.name, product: item.product.title | escape }}" disabled>
                    {%- for value in option.values -%}
                      {%- assign value_name = value | append: '' -%}
                      <option value="{{ value_name | escape }}"{% if value_name == current_value %} selected{% endif %}>{{ value_name | escape }}</option>
                    {%- endfor -%}
                  </select>
                  {%- render 'icon-caret' -%}
                </div>
              {%- endfor -%}
            </cart-line-variant>
          {%- endif -%}
          <dl>
            {%- if item.product.has_only_default_variant == false and variant_change == false -%}
              {%- if opts.displayed_variants == 'pills' -%}
                <div class="product-option cart-line-pills">
                  {%- for option in item.options_with_values -%}
                    <span class="cart-line-pill"><span class="visually-hidden">{{ option.name }}: </span>{{ option.value }}</span>
                  {%- endfor -%}
                </div>
              {%- elsif opts.displayed_variants == 'compact' -%}
                <div class="product-option">
                  {{ item.options_with_values | map: 'value' | join: ' / ' }}
                </div>
              {%- else -%}
                {%- for option in item.options_with_values -%}
                  <div class="product-option">
                    <dt>{{ option.name }}:</dt>
                    <dd>
                      {{ option.value -}}
                      {%- unless forloop.last %}, {% endunless %}
                    </dd>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}

            {%- for property in item.properties -%}
              {%- assign property_first_char = property.first | slice: 0 -%}
              {%- if property.last != blank and property_first_char != '_' -%}
                <div class="product-option">
                  <dt>{{ property.first }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a
                        href="{{ property.last }}"
                        class="link"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-describedby="a11y-new-window-message"
                      >
                        {{ property.last | split: '/' | last }}
                      </a>
                    {%- else -%}
                      {{ property.last }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>

          <p class="product-option cart-item__plan-name">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}

        {%- if item.item_components.size > 0 -%}
          <ul class="cart-item__bundle list-unstyled" role="list" aria-label="{{ 'sections.cart.lines_bundle_contents' | t }}">
            {%- for component in item.item_components -%}
              <li class="cart-item__bundle-item">
                {%- if opts.bundle_show_images and component.image -%}
                  <img
                    class="cart-item__bundle-item-image"
                    src="{{ component.image | image_url: width: 80 }}"
                    width="40"
                    height="40"
                    loading="lazy"
                    alt=""
                  >
                {%- endif -%}
                <span class="cart-item__bundle-item-title">{{ component.title | escape }}</span>
                {%- if component.quantity > 1 -%}
                  <span class="cart-item__bundle-item-qty"> × {{ component.quantity }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} Stock note (tracked stock only) {%- endcomment -%}
        {%- if opts.show_stock_status and item.variant.inventory_management != blank -%}
          {%- liquid
            assign in_cart = cart | item_count_for_variant: item.variant_id
            assign stock = item.variant.inventory_quantity
          -%}
          {%- if item.variant.inventory_policy == 'deny' and stock > 0 and stock <= opts.low_stock_threshold and opts.low_stock_text != blank -%}
            <p class="cart-line-note cart-line-note--low-stock">{{ opts.low_stock_text | escape | replace: '[quantity]', stock }}</p>
          {%- elsif item.variant.inventory_policy == 'continue' and in_cart > stock and opts.backorder_text != blank -%}
            <p class="cart-line-note cart-line-note--backorder">{{ opts.backorder_text | escape }}</p>
          {%- endif -%}
        {%- endif -%}
        {%- comment -%} Quantity rules and volume price (B2B catalogs) {%- endcomment -%}
        {%- if opts.show_quantity_rules -%}
          {%- liquid
            assign rule = item.variant.quantity_rule
            assign rules_text = ''
            if rule.min > 1
              assign rules_text = 'products.product.quantity.minimum_of' | t: quantity: rule.min
            endif
            if rule.max != null
              assign max_text = 'products.product.quantity.maximum_of' | t: quantity: rule.max
              if rules_text != blank
                assign rules_text = rules_text | append: ' · '
              endif
              assign rules_text = rules_text | append: max_text
            endif
            if rule.increment > 1
              assign inc_text = 'products.product.quantity.multiples_of' | t: quantity: rule.increment
              if rules_text != blank
                assign rules_text = rules_text | append: ' · '
              endif
              assign rules_text = rules_text | append: inc_text
            endif
            assign next_break = nil
            if opts.volume_price_text != blank and item.variant.quantity_price_breaks_configured?
              assign in_cart = cart | item_count_for_variant: item.variant_id
              for price_break in item.variant.quantity_price_breaks
                if price_break.minimum_quantity > in_cart and price_break.price < item.final_price
                  if next_break == nil or price_break.minimum_quantity < next_break.minimum_quantity
                    assign next_break = price_break
                  endif
                endif
              endfor
            endif
          -%}
          {%- if rules_text != blank -%}<p class="cart-line-note cart-line-note--rules">{{ rules_text }}</p>{%- endif -%}
          {%- if next_break -%}
            {%- capture vp_qty -%}{{ next_break.minimum_quantity | minus: in_cart }}{%- endcapture -%}
            {%- capture vp_price -%}{{ next_break.price | money }}{%- endcapture -%}
            <p class="cart-line-note cart-line-note--volume">{%- render 'cart-text', text: opts.volume_price_text, quantity: vp_qty, price: vp_price -%}</p>
          {%- endif -%}
        {%- endif -%}
        {%- comment -%} Product disclosures set to show in the cart, for the buyer's country {%- endcomment -%}
        {%- assign disclosures = item.product.metafields.shopify.disclosure.value -%}
        {%- if disclosures != blank -%}
          {%- capture disclosure_rows -%}
            {%- for disclosure in disclosures -%}
              {%- liquid
                assign show_d = false
                assign surfaces = disclosure.display_preferences.value.surfaces
                if surfaces contains 'cart'
                  assign show_d = true
                endif
                assign juris = disclosure.jurisdictions.value
                if show_d and juris != blank
                  assign show_d = false
                  for code in juris
                    assign code_country = code | split: '-' | first
                    if code_country == localization.country.iso_code
                      assign show_d = true
                    endif
                  endfor
                endif
              -%}
              {%- if show_d and disclosure.title.value != blank -%}
                <div class="cart-line-disclosures__item">
                  <p class="cart-line-disclosures__title">{%- if disclosure.symbol != blank -%}<img class="cart-line-disclosures__symbol" src="{{ disclosure.symbol.value | image_url: width: 40 }}" alt="" width="16" height="16" loading="lazy">{%- endif -%}<span>{{ disclosure.title.value | escape }}</span></p>
                  {%- if disclosure.content != blank -%}<div class="cart-line-disclosures__content rte">{{ disclosure.content | metafield_tag }}</div>{%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if disclosure_rows != blank -%}
            <details class="cart-line-disclosures" id="CartLineDisclosures-{{ scope }}-{{ item.key | replace: ':', '-' }}" data-preserve data-cart-feature="lines:css">
              <summary class="cart-line-disclosures__summary">{{ 'sections.cart.lines_disclosures' | t }}</summary>
              {{ disclosure_rows }}
            </details>
          {%- endif -%}
        {%- endif -%}
        {%- comment -%} Subscribe & save on this line {%- endcomment -%}
        {%- if opts.show_subscribe_save and sub != blank -%}
          {%- render 'cart-subscription-toggle', item: item, index: line, opts: opts, cart_style: cart_style, surface: surface_name, eligibility: sub, scope: scope, sample: sub_sample -%}
        {%- endif -%}
        {%- comment -%} Save for later (moves the item to the wishlist) {%- endcomment -%}
        {%- if save_later -%}
          <button type="button" class="link cart-save-later" data-save-later aria-label="{{ 'sections.cart.lines_save_for_later_aria' | t: product: item.product.title | escape }}">{{ opts.save_for_later_label | escape }}</button>
        {%- endif -%}
      </div>
      {%- unless no_remove -%}
        {%- if context == 'page' -%}
          <span class="cart-drawer-item__cart-remove-button cart-line-remove{% if opts.remove_style == 'text' %} cart-line-remove--text{% endif %}" id="CartPage-Remove-{{ line }}">
            <button type="button" class="{% if opts.remove_style == 'text' %}link cart-line-remove__text{% else %}button button--tertiary{% endif %}" data-line-remove aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
              {%- if opts.remove_style == 'text' -%}{{ 'sections.cart.lines_remove' | t }}{%- else -%}{% render 'icon-remove' %}{%- endif -%}
            </button>
          </span>
        {%- elsif opts.remove_style == 'text' -%}
          <cart-remove-button class='cart-drawer-item__cart-remove-button cart-line-remove--text' id="CartDrawer-Remove-{{ line }}" data-index="{{ line }}" data-handle="{{ item.product.handle }}">
            <button type="button" class="link cart-line-remove__text" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">{{ 'sections.cart.lines_remove' | t }}</button>
          </cart-remove-button>
        {%- else -%}
          <cart-remove-button
            class='cart-drawer-item__cart-remove-button'
            id="CartDrawer-Remove-{{ line }}"
            data-index="{{ line }}"
            data-handle="{{ item.product.handle }}"
          >
            <button
              type="button"
              class="button button--tertiary"
              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
            >
              {% render 'icon-remove' %}
            </button>
          </cart-remove-button>
        {%- endif -%}
      {%- endunless -%}
    </div>

    <div class='cart-drawer-item__quantity-and-prices{% if opts.prices_position == 'left' %} cart-drawer-item__quantity-and-prices--reverse{% endif %}{% if has_props != false %} cart-drawer-item__quantity-and-prices--has-props{% endif %}'>
      <div class="cart-item__quantity">
        <div class="cart-item__quantity-wrapper">
          {%- if opts.quantity_styling == 'theme' -%}
            <quantity-input class="quantity main-quantity cart-quantity cart-quantity--theme color-{{ settings.quantity_color_scheme }} accent-color-{{ settings.quantity_overlay_color }} accent-2-color-{{ settings.quantity_text_color }}{% if hide_quantity %} hidden{% endif %}">
              <button class="quantity__button no-js-hidden" name="minus" type="button"{% if no_quantity %} disabled{% endif %}>
                <span class="visually-hidden">
                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                </span>
                {% render 'icon-minus' %}
              </button>
              <input
                class="quantity__input"
                type="number"
                data-quantity-variant-id="{{ item.variant.id }}"
                name="updates[]"
                value="{{ item.quantity }}"
                {% # theme-check-disable %}
                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                min="{{ item.variant.quantity_rule.min }}"
                {% if item.variant.quantity_rule.max != null %}
                  max="{{ item.variant.quantity_rule.max }}"
                {% endif %}
                step="{{ item.variant.quantity_rule.increment }}"
                {% # theme-check-enable %}
                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                id="{{ qty_prefix }}-quantity-{{ line }}"
                data-index="{{ line }}"
                {% if no_quantity %}readonly{% endif %}
              >
              <button class="quantity__button no-js-hidden" name="plus" type="button"{% if no_quantity %} disabled{% endif %}>
                <span class="visually-hidden">
                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                </span>
                {% render 'icon-plus' %}
              </button>
            </quantity-input>
          {%- else -%}
            <quantity-input
              class="quantity cart-quantity color-{{ opts.quantity_container_color_scheme }}{% if opts.quantity_round_btns %} cart-quantity--round-btns{% endif %}{% if opts.quantity_outline_btns %} cart-quantity--outline-btns{% endif %}{% if hide_quantity %} hidden{% endif %}"
              style='
                --font-size:{{ opts.quantity_font_size | divided_by: 10.0 }}rem;
                --border-width:0.{{ opts.quantity_border_width }}rem;
                --border-color:{{ opts.quantity_border_color }};
                --corner-radius:{{ opts.quantity_corner_radius | divided_by: 10.0 }}rem;
                --container-padding:{{ opts.quantity_container_padding }}em;
                --input-padding:{{ opts.quantity_input_padding }}em;
                --separator-opacity:{{ opts.quantity_separators_opacity | divided_by: 100.0 }};
                --padding:{{ opts.quantity_padding }}em;
                --icon-size:{{ opts.quantity_btns_icon_size | divided_by: 100.0 }}em;
              '
            >
              <button class="quantity__button quantity__button--minus no-js-hidden color-{{ opts.quantity_btns_color_scheme }}" name="minus" type="button"{% if no_quantity %} disabled{% endif %}>
                <span class="visually-hidden">
                  {{-
                    'products.product.quantity.decrease'
                    | t: product: item.product.title
                    | escape
                  -}}
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill='currentColor'>
                  <path d="M432 256c0 17.7-14.3 32-32 32L48 288c-17.7 0-32-14.3-32-32s14.3-32 32-32l352 0c17.7 0 32 14.3 32 32z"/>
                </svg>
              </button>
              <input
                class="quantity__input"
                type="number"
                data-quantity-variant-id="{{ item.variant.id }}"
                name="updates[]"
                value="{{ item.quantity }}"
                {% # theme-check-disable %}
                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                min="{{ item.variant.quantity_rule.min }}"
                {% if item.variant.quantity_rule.max != null %}
                  max="{{ item.variant.quantity_rule.max }}"
                {% endif %}
                step="{{ item.variant.quantity_rule.increment }}"
                {% # theme-check-enable %}
                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                id="{{ qty_prefix }}-quantity-{{ line }}"
                data-index="{{ line }}"
                {% if no_quantity %}readonly{% endif %}
              >
              <button class="quantity__button quantity__button--plus no-js-hidden color-{{ opts.quantity_btns_color_scheme }}" name="plus" type="button"{% if no_quantity %} disabled{% endif %}>
                <span class="visually-hidden">
                  {{-
                    'products.product.quantity.increase'
                    | t: product: item.product.title
                    | escape
                  -}}
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill='currentColor'>
                  <path d="M256 80c0-17.7-14.3-32-32-32s-32 14.3-32 32V224H48c-17.7 0-32 14.3-32 32s14.3 32 32 32H192V432c0 17.7 14.3 32 32 32s32-14.3 32-32V288H400c17.7 0 32-14.3 32-32s-14.3-32-32-32H256V80z"/>
                </svg>
              </button>
            </quantity-input>
          {%- endif -%}
          {%- if hide_quantity and item.quantity > 1 -%}
            <span class="cart-item__quantity-text">&times; {{ item.quantity }}</span>
          {%- endif -%}
          {%- comment -%} Quantity breaks V2 gift lines hide their quantity selector too {%- endcomment -%}
          {%- if hide_quantity == false and item.quantity > 1 and item.properties['_qb_gift'] != blank -%}
            <span class="cart-item__quantity-text">&times; {{ item.quantity }}</span>
          {%- endif -%}
          {%- comment -%} Free items under the Highlight style hide their selector (rule in component-cart-lines.css) {%- endcomment -%}
          {%- if free_item_style == 'highlight' and is_free and hide_quantity == false and item.quantity > 1 and item.properties['_qb_gift'] == blank -%}
            <span class="cart-item__quantity-text cart-line-free-qty">&times; {{ item.quantity }}</span>
          {%- endif -%}
        </div>

        <div
          id="{{ id_prefix }}-LineItemError-{{ line }}"
          class="cart-item__error"
          role="alert"
        >
          <small class="cart-item__error-text"></small>
          <svg
            aria-hidden="true"
            focusable="false"
            class="icon icon-error"
            viewBox="0 0 13 13"
          >
            <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
            <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
            <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
            <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
          </svg>
        </div>
      </div>

      <div class="cart-item__totals {{ opts.prices_position }}">
        <div class="cart-item__price-wrapper">
          {% if display_compare %}
            {% liquid
              assign item_saving = compare_price | minus: item.final_line_price
              assign total_compare_price = total_compare_price | plus: compare_price
            %}
            <div class="cart-item__discounted-prices">
              <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
              <s class="cart-item__old-price price--end compare-price color-foreground-{{ opts.compare_price_color }}">
                {{ compare_price | money }}
              </s>
              <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
              <span class="price--end regular-price accent-color-{{ opts.price_color }}">
                {% if opts.free_prices_text != blank and item.final_line_price == 0 %}
                  {{ opts.free_prices_text }}
                {% else %}
                  {{ item.final_line_price | money }}
                {% endif %}
              </span>
            </div>
            {% if opts.enable_savings %}
              <span class='cart-drawer-item__saving text-color-{{ opts.savings_color }}'>
                {%- capture saved_money_span -%}{{ item_saving | money_without_trailing_zeros }}{%- endcapture -%}
                {%- capture saved_pct -%}{{ item_saving | times: 100 | divided_by: compare_price }}%{%- endcapture -%}
                {%- render 'cart-text', text: opts.savings_text, amount: saved_money_span, percentage: saved_pct -%}
              </span>
            {% endif %}
          {% else %}
            {% liquid
              assign total_compare_price = total_compare_price | plus: item.original_line_price
            %}
            <span class="price--end regular-price accent-color-{{ opts.price_color }}">
              {% if opts.free_prices_text != blank and item.original_line_price == 0 %}
                {{ opts.free_prices_text }}
              {% else %}
                {{ item.original_line_price | money }}
              {% endif %}
            </span>
          {% endif %}

          {%- if item.variant.available and item.unit_price_measurement -%}
            <div class="unit-price caption">
              <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
              {{ item.unit_price | money }}
              <span aria-hidden="true">/</span>
              <span class="visually-hidden"
                >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
              >
              {%- if item.unit_price_measurement.reference_value != 1 -%}
                {{- item.unit_price_measurement.reference_value -}}
              {%- endif -%}
              {{ item.unit_price_measurement.reference_unit }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</li>
