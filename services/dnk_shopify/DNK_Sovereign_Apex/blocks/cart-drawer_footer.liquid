<div class="drawer__footer{% if section.settings.footer_shape != 'none' and section.settings.footer_shape != blank %}{% if section.settings.footer_bg_type != 'none' or section.settings.body_bg_type != 'none' %} cart-footer-shape cart-footer-shape--{{ section.settings.footer_shape }}{% endif %}{% endif %}" {{ block.shopify_attributes }}>
  {%- if block.blocks.size == 0 -%}
    {% render 'cart-editor-notice', code: 'core-footer-empty', level: 'info', title: 'Cart footer', text: 'no blocks yet. Add Subtotals and a Checkout button.' %}
  {%- endif -%}
  {% content_for 'blocks' %}
  <!-- end footer -->
</div>

