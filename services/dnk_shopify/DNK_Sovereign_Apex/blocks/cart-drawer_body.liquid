<div class="cart-drawer__body" {{ block.shopify_attributes }}>
  {%- if block.blocks.size == 0 -%}
    {% render 'cart-editor-notice', code: 'core-body-empty', level: 'info', title: 'Cart body', text: 'no blocks yet. Add Cart items and the other blocks you want in the cart.' %}
  {%- endif -%}
  {% content_for 'blocks' %}
  {%- comment -%} Beside the cart with Desktop layout Two columns; otherwise (and on phones) its blocks follow the others {%- endcomment -%}
  {% content_for 'block', type: 'cart-drawer_side-panel', id: 'SidePanel' %}
</div>

