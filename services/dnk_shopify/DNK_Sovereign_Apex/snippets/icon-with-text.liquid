{% comment %}
  Renders icon with text block

  Accepts:
  - block: {Object} passes in the block information.

  Usage:
  {% render 'icon-with-text',
    block: block
  %}
{% endcomment %}
{%- liquid
  assign heading_1_empty = false
  assign heading_2_empty = false
  assign heading_3_empty = false
  assign text_only_all_items = true

  if block.settings.heading_1 == empty
    assign heading_1_empty = true
  endif

  if block.settings.heading_2 == empty
    assign heading_2_empty = true
  endif

  if block.settings.heading_3 == empty
    assign heading_3_empty = true
  endif

  if heading_1_empty == false and block.settings.icon_1 != 'none' or block.settings.image_1 != null
    assign text_only_all_items = false
  elsif heading_2_empty == false and block.settings.icon_2 != 'none' or block.settings.image_2 != null
    assign text_only_all_items = false
  elsif heading_3_empty == false and block.settings.icon_3 != 'none' or block.settings.image_3 != null
    assign text_only_all_items = false
  endif

  assign styled = false
  if block.settings.bg_type != 'none' or block.settings.border_width > 0 or block.settings.enable_shadow
    assign styled = true
  endif
-%}
<ul
  class="icon-with-text icon-with-text--icon-{{ block.settings.icon_size }} icon-with-text--{{ block.settings.layout }} list-unstyled{% if text_only_all_items %} icon-with-text--text-only{% endif %}{% if block.settings.show_separators %} icon-with-text--separators{% endif %}{% if styled %} icon-with-text--styled border-custom{% unless block.settings.round_corners_equally %} corners-uneven{% endunless %}{% endif %}{% if block.settings.border_width > 0 and block.settings.border_color_type == 'gradient' %} border-gradient{% endif %}{% if block.settings.bg_type == 'gradient' %} bg-gradient{% endif %}{% if block.settings.enable_shadow %} block-shadow{% endif %} {{ block.settings.visibility }}"
  style="
    --desktop-icon-size: {{ block.settings.desktop_icon_size | divided_by: 10.0 }}rem;
     --desktop-spacing: {{ block.settings.desktop_spacing | divided_by: 10.0 }}rem;
     --desktop-text-size: {{ block.settings.desktop_text_size | divided_by: 10.0 }}rem;
     --desktop-subtext-size: {{ block.settings.desktop_subtext_size | divided_by: 10.0 }}rem;
     --mobile-icon-size: {{ block.settings.mobile_icon_size | divided_by: 10.0 }}rem;
     --mobile-spacing: {{ block.settings.mobile_spacing | divided_by: 10.0 }}rem;
     --mobile-text-size: {{ block.settings.mobile_text_size | divided_by: 10.0 }}rem;
     --mobile-subtext-size: {{ block.settings.mobile_subtext_size | divided_by: 10.0 }}rem;
    {% if block.settings.heading_color == 'custom' %}
      --heading-color: {{ block.settings.custom_heading_color }};
    {% elsif block.settings.heading_color != 'inherit' %}
      --heading-color: rgb(var(--color-base-{{ block.settings.heading_color }}));
    {% endif %}
    {% if block.settings.text_color == 'custom' %}
      --text-color: {{ block.settings.custom_text_color }};
    {% elsif block.settings.text_color != 'inherit' %}
      --text-color: rgb(var(--color-base-{{ block.settings.text_color }}));
    {% endif %}
    {% if block.settings.show_separators %}
      --separator-color: rgba(var(--color-base-{{ block.settings.separator_color }}), {{ block.settings.separator_opacity | divided_by: 100.0 }});
      --separator-thickness: {{ block.settings.separator_thickness }}px;
    {% endif %}
    {% if styled %}
      {% if block.settings.bg_type == 'solid' %}
        {% assign red = block.settings.bg_color | color_extract: 'red' %}
        {% assign green = block.settings.bg_color | color_extract: 'green' %}
        {% assign blue = block.settings.bg_color | color_extract: 'blue' %}
        --bg-color: rgba({{ red }}, {{ green }}, {{ blue }}, {{ block.settings.bg_opacity | divided_by: 100.0 }});
      {% elsif block.settings.bg_type == 'gradient' %}
        --bg-color: {{ block.settings.bg_gradient }};
        --bg-opacity: {{ block.settings.bg_opacity | divided_by: 100.0 }};
      {% else %}
        --bg-color: transparent;
      {% endif %}
      --border-style: {{ block.settings.border }};
      --border-width: {{ block.settings.border_width }}px;
      {% if block.settings.round_corners_equally %}
        --border-radius: {{ block.settings.border_radius }}px;
      {% else %}
        --border-radius: {{ block.settings.border_radius_top_left }}px {{ block.settings.border_radius_top_right }}px {{ block.settings.border_radius_bottom_right }}px {{ block.settings.border_radius_bottom_left }}px;
      {% endif %}
      {% if block.settings.border_color_type == 'solid' %}
        {% assign border_alpha = block.settings.border_opacity | divided_by: 100.0 %}
        --border-color: {{ block.settings.border_color | color_modify: 'alpha', border_alpha }};
      {% elsif block.settings.border_color_type == 'gradient' %}
        --border-color: {{ block.settings.border_gradient }};
        --border-opacity: {{ block.settings.border_opacity | divided_by: 100.0 }};
      {% endif %}
      {% if block.settings.enable_shadow %}
        {% assign shadow_alpha = block.settings.shadow_opacity | divided_by: 100.0 %}
        --shadow-color: {{ block.settings.shadow_color | color_modify: 'alpha', shadow_alpha }};
        --shadow-offset-x: {{ block.settings.shadow_horizontal_offset }}px;
        --shadow-offset-y: {{ block.settings.shadow_vertical_offset }}px;
        --shadow-blur: {{ block.settings.shadow_blur }}px;
        --shadow-spread: {{ block.settings.shadow_spread }}px;
      {% endif %}
      --padding-y--mobile: {{ block.settings.vertical_mobile_padding | divided_by: 10.0 }}rem;
      --padding-x--mobile: {{ block.settings.horizontal_mobile_padding | divided_by: 10.0 }}rem;
      --padding-y--desktop: {{ block.settings.vertical_desktop_padding | divided_by: 10.0 }}rem;
      --padding-x--desktop: {{ block.settings.horizontal_desktop_padding | divided_by: 10.0 }}rem;
    {% endif %}
      margin-top: {{ block.settings.margin_top | divided_by: 10.0 }}rem;
      margin-bottom: {{ block.settings.margin_bottom | divided_by: 10.0 }}rem;
    "
  {{ block.shopify_attributes }}
>
  {%- unless heading_1_empty -%}
    <li class="icon-with-text__item">
      {%- if block.settings.image_1 == null -%}
        {% render 'material-icon', icon: block.settings.icon_1, filled: block.settings.icon_1_fill, custom_color: block.settings.icon_color %}
      {%- else -%}
        <img
          src="{{ block.settings.image_1 | image_url }}"
          {% if block.settings.image_1.alt != blank %}
            alt="{{ block.settings.image_1.alt | escape }}"
          {% else %}
            role="presentation"
          {% endif %}
          height="auto"
          width="auto"
          loading="lazy"
        >
      {%- endif -%}
      {%- if block.settings.text_1 != blank -%}
        <div class="icon-with-text__content">
          <span class="h4">
            {{- block.settings.heading_1 -}}
          </span>
          <span class="icon-with-text__text">{{ block.settings.text_1 }}</span>
        </div>
      {%- else -%}
        <span class="h4">
          {{- block.settings.heading_1 -}}
        </span>
      {%- endif -%}
    </li>
  {%- endunless -%}
  {%- unless heading_2_empty -%}
    <li class="icon-with-text__item">
      {%- if block.settings.image_2 == null -%}
        {% render 'material-icon', icon: block.settings.icon_2, filled: block.settings.icon_2_fill, custom_color: block.settings.icon_color %}
      {%- else -%}
        <img
          src="{{ block.settings.image_2 | image_url }}"
          {% if block.settings.image_2.alt != blank %}
            alt="{{ block.settings.image_2.alt | escape }}"
          {% else %}
            role="presentation"
          {% endif %}
          height="auto"
          width="auto"
          loading="lazy"
        >
      {%- endif -%}
      {%- if block.settings.text_2 != blank -%}
        <div class="icon-with-text__content">
          <span class="h4">
            {{- block.settings.heading_2 -}}
          </span>
          <span class="icon-with-text__text">{{ block.settings.text_2 }}</span>
        </div>
      {%- else -%}
        <span class="h4">
          {{- block.settings.heading_2 -}}
        </span>
      {%- endif -%}
    </li>
  {%- endunless -%}
  {%- unless heading_3_empty -%}
    <li class="icon-with-text__item">
      {%- if block.settings.image_3 == null -%}
        {% render 'material-icon', icon: block.settings.icon_3, filled: block.settings.icon_3_fill, custom_color: block.settings.icon_color %}
      {%- else -%}
        <img
          src="{{ block.settings.image_3 | image_url }}"
          {% if block.settings.image_3.alt != blank %}
            alt="{{ block.settings.image_3.alt | escape }}"
          {% else %}
            role="presentation"
          {% endif %}
          height="auto"
          width="auto"
          loading="lazy"
        >
      {%- endif -%}
      {%- if block.settings.text_3 != blank -%}
        <div class="icon-with-text__content">
          <span class="h4">
            {{- block.settings.heading_3 -}}
          </span>
          <span class="icon-with-text__text">{{ block.settings.text_3 }}</span>
        </div>
      {%- else -%}
        <span class="h4">
          {{- block.settings.heading_3 -}}
        </span>
      {%- endif -%}
    </li>
  {%- endunless -%}
</ul>
