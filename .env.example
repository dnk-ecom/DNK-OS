# DNK OS Environment Configuration (Example)
# Copy to .env and configure secrets locally. NEVER commit .env to git.

# Runtime Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Agent & LLM Providers
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub API Integration
GH_TOKEN=
GITHUB_TOKEN=

# Ecosystem Shared IPC Paths (Optional relative overrides)
DNK_HUB_ROOT=../DNK_HUB
DNK_SHOPIFY_BUILDER_ROOT=../DNK-Shopify-AI-Builder
CLAUDE_CODE_DNK_ROOT=../Claude_Code_DNK
DNK_RESEARCHER_ROOT=../DNK_Researcher
