# Скопіюйте цей файл у ~/.zettcode/config.toml
# або запустіть zettcode із змінною:
# ZETTCODE_CONFIG=/Users/<username>/Kuzmenko/MY_LIFE_WORK/DNK_OS/config/config.toml zettcode

# Приклад 1: DeepSeek (рекомендовано для швидкого та дешевого кодингу)
[[models]]
model = "deepseek-chat"
display_model = "DeepSeek V3"
token = "sk-..."                      # вкажіть ваш DEEPSEEK_API_KEY
base_url = "https://api.deepseek.com"
context_window = 128000
multimodal = false

[[models]]
model = "deepseek-reasoner"
display_model = "DeepSeek R1 (Auditor)"
token = "sk-..."
base_url = "https://api.deepseek.com"
context_window = 128000
multimodal = false

