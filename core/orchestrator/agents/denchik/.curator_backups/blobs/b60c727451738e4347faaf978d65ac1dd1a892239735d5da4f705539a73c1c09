## 🔍 2. In-RAM Git Object Introspection (Zero Context Bloat)

Never run raw terminal dumps of git logs. Run a fast, deterministic Python probe in RAM via `execute_code`:

```python
import subprocess

# 1. Map all object hashes to their file paths
proc = subprocess.Popen(
    ["git", "rev-list", "--objects", "--all"],
    stdout=subprocess.PIPE, text=True
)
obj_paths = {}
for line in proc.stdout:
    parts = line.strip().split(maxsplit=1)
    obj_paths[parts[0]] = parts[1] if len(parts) == 2 else ""
proc.wait()

# 2. Batch query uncompressed and disk-compressed sizes
cat_proc = subprocess.Popen(
    ["git", "cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize) %(objectsize:disk)"],
    stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True
)
stdout, _ = cat_proc.communicate(input="\n".join(obj_paths.keys()))

# 3. Sort blobs by size and correlate with HEAD status
blobs = []
for line in stdout.splitlines():
    parts = line.split()
    if len(parts) >= 4 and parts[1] == "blob":
        sha, size, disk_size = parts[0], int(parts[2]), int(parts[3])
        path = obj_paths.get(sha, "")
        blobs.append((size, disk_size, sha, path))

blobs.sort(reverse=True, key=lambda x: x[0])
for size, disk_size, sha, path in blobs[:25]:
    print(f"{size/(1024*1024):>8.1f} MB (disk: {disk_size/(1024*1024):>6.1f} MB) : {path or sha}")
```

