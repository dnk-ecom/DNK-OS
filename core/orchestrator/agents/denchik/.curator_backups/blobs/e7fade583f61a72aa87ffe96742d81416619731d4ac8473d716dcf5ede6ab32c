## 2. Pydantic V2 Auto-Inference Pattern (`@model_validator(mode="before")`)

To make input models robust against varying LLM invocation formats, define an automatic domain-sniffing pre-validator:

```python
from pydantic import BaseModel, Field, model_validator
from enum import Enum
import re

class SocialPlatform(str, Enum):
    TIKTOK = "tiktok"
    INSTAGRAM = "instagram"
    YOUTUBE = "youtube"
    FACEBOOK = "facebook"
    REDDIT = "reddit"
    LINKEDIN = "linkedin"
    TWITTER = "twitter"

class CommentMiningRequest(BaseModel):
    post_url: str = Field(..., description="Direct URL to video, reel, or post")
    platform: SocialPlatform | None = Field(None, description="Auto-detected if omitted")
    max_comments: int = Field(50, ge=1, le=500)

    @model_validator(mode="before")
    @classmethod
    def auto_detect_platform(cls, values: dict) -> dict:
        if not isinstance(values, dict):
            return values
        
        # Support url alias if LLM supplies 'url' instead of 'post_url'
        url = values.get("post_url") or values.get("url")
        if url:
            values["post_url"] = url
            if not values.get("platform"):
                lower = url.lower()
                if "tiktok.com" in lower:
                    values["platform"] = SocialPlatform.TIKTOK
                elif "instagram.com" in lower:
                    values["platform"] = SocialPlatform.INSTAGRAM
                elif "youtube.com" in lower or "youtu.be" in lower:
                    values["platform"] = SocialPlatform.YOUTUBE
                elif "facebook.com" in lower:
                    values["platform"] = SocialPlatform.FACEBOOK
                elif "reddit.com" in lower:
                    values["platform"] = SocialPlatform.REDDIT
                elif "linkedin.com" in lower:
                    values["platform"] = SocialPlatform.LINKEDIN
                elif "twitter.com" in lower or "x.com" in lower:
                    values["platform"] = SocialPlatform.TWITTER
        return values
```

