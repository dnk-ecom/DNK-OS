+  license_spdx: "MIT"
+  assimilation_track: "open_source"
+  provenance_note: "Imported via plugin_github_intake.py"
+
+entrypoint:
+  type: "python"
+  reference: "plugins/github_plugin_001:Plugin"
+
+capabilities:
+  provides: []
+  requires: []
+
+permissions:
+  filesystem: "none"
+  network: "none"
+  secrets: "none"
+  git: "none"
+  database: "none"
+  external_write: "none"
+
+governance:
