+validation:
+  draft_card: PASS | FAIL
+  draft_to_sandbox: PASS | FAIL
+  sandbox_to_active_without_evidence: BLOCKED | FAIL
+safety:
+  runtime_changed: false
+  plugins_activated: false
+  network_called: false
+  secrets_read: false
+  external_services_called: false
+  database_changed: false
+evidence: ""
+commit: ""
+next_recommended_slice: "PLUGIN-002 Sandbox Runner Design"
