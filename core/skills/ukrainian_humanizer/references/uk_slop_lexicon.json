  "structures": [
    {
      "id": "not-just-uk",
      "regex": "(?i)\\bце не просто [^.!?,\\n]{2,60}[,—-] це\\b",
      "name": "Негативний паралелізм («Це не просто X — це Y»)",
      "fix": "Приберіть штучну драматизацію. Напишіть прямо, чим є предмет і яку користь він дає."
    },
    {
      "id": "not-only-uk",
      "regex": "(?i)\\bне (?:лише|тільки) [^.!?,\\n]{2,60}, а(?:ле)? й\\b",
      "name": "Конструкція «Не лише X, але й Y»",
      "fix": "Розбийте на два окремі факти або з'єднайте простим «і» / «та»."
    },
    {
      "id": "passive-bulo",
      "regex": "(?i)\\bбуло (?:створено|розроблено|зроблено|впроваджено|досягнуто|виконано|забезпечено|реалізовано)\\b",
      "name": "Безособовий пасив на «було -но/-то»",
      "fix": "Замініть на активний стан із конкретним діячем («ми розробили», «майстри виточили»)."
    },
    {
      "id": "passive-sya",
      "regex": "(?i)\\b(?:здійснюється|забезпечується|виконується|проводиться|реалізується|пропонується|гарантується|створюється)\\b",
      "name": "Канцелярський пасив на «-ться»",
      "fix": "Замініть на пряму дію: замість «доставка здійснюється» пишіть «доставляємо за 2 дні»."
    },
    {
      "id": "participle-calc",
      "regex": "(?i)\\b\\w+(?:ючий|юча|юче|ючі|ачий|ача|аче|ачі)\\b",
      "name": "Активні дієприкметники теперішнього часу (калька на -учий/-ючий)",
      "fix": "Неприродно для української мови: замініть на прикметник, іменник або підрядне речення з «який» (напр. «діючий» -> «чинний», «вражаючий» -> «яскравий»)."
    },
    {
      "id": "em-dash-overload",
      "regex": "—",
      "name": "Надлишок довгих тире (Em-dash — маркер синтаксису LLM)",
      "fix": "Більше 1 тире на абзац видає ШІ. Замініть частину тире на двокрапку, кому або розбийте на два речення."
    },
    {
      "id": "rocket-sparkles",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF\\U0001F48E\\U0001F31F]",
      "name": "ШІ-емодзі (🚀, 🔥, 💡, ✨, 🎯, 💎, 🌟)",
      "fix": "Видаліть шаблонні декоративні емодзі на початку списків та заголовків."
    },
    {
      "id": "colon-bold-bullets",
      "regex": "(?m)^\\s*[-*•]\\s+\\*\\*[^*:\\n]{2,40}:\\*\\*",
      "name": "Шаблонний список ШІ («- **Жирний заголовок:** пояснення»)",
      "fix": "Розчиніть однотипні списки з жирними префіксами у живий абзац або приберіть двокрапки після жирного шрифту."
    },
    {
      "id": "rhetorical-reveal",
      "regex": "(?im)^\\s*(?:результат|секрет|найкраща частина|у чому секрет|що в результаті)\\?\\s*$",
      "name": "Однослівне риторичне питання-підводка («Результат?», «У чому секрет?»)",
      "fix": "Приберіть театральну паузу і відразу скажіть факт."
    }
  ]
