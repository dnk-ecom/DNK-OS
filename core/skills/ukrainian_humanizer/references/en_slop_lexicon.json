  "structures": [
    {
      "id": "not-just-en",
      "regex": "(?i)\\bit(?:'s| is) not just [^.!?,\\n]{2,60}[,—-] it(?:'s| is)\\b",
      "name": "Negative parallelism ('It's not just X — it's Y')",
      "fix": "Drop the artificial contrast. State directly what the subject does."
    },
    {
      "id": "not-only-en",
      "regex": "(?i)\\bnot only [^.!?,\\n]{2,60},? but also\\b",
      "name": "Correlative 'Not only X, but also Y'",
      "fix": "Split into two direct facts or connect with 'and'."
    },
    {
      "id": "participle-tail-en",
      "regex": ",\\s+(?:ensuring|highlighting|underscoring|fostering|showcasing|demonstrating|paving the way for|contributing to)\\b",
      "name": "Trailing participle clause (', ensuring/highlighting/fostering...')",
      "fix": "Delete the tacked-on significance tail or start a concrete new sentence."
    },
    {
      "id": "passive-voice-en",
      "regex": "(?i)\\b(?:was|were|is|are|been)\\s+(?:created|developed|designed|implemented|achieved|established|conducted|utilized|leveraged)\\b",
      "name": "Impersonal passive voice ('was developed / is utilized')",
      "fix": "Use active voice with a concrete actor ('our engineers built', 'we tested')."
    },
    {
      "id": "em-dash-overload",
      "regex": "—",
      "name": "Excessive em-dashes (—)",
      "fix": "More than 1 em-dash per paragraph signals LLM syntax. Replace with periods, commas, or colons."
    },
    {
      "id": "rocket-sparkles",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF\\U0001F48E\\U0001F31F]",
      "name": "AI decorative emojis (🚀, 🔥, 💡, ✨, 🎯, 💎, 🌟)",
      "fix": "Remove stock decorative emojis from headings and bullet lists."
    },
    {
      "id": "colon-bold-bullets",
      "regex": "(?m)^\\s*[-*•]\\s+\\*\\*[^*:\\n]{2,40}:\\*\\*",
      "name": "Bold-colon bullet list ('- **Bold header:** explanation')",
      "fix": "Convert formulaic bold-header bullets into natural prose or varied list items."
    },
    {
      "id": "rhetorical-reveal-en",
      "regex": "(?im)^\\s*(?:the result|the secret|the best part|the bottom line|the catch)\\?\\s*$",
      "name": "One-phrase rhetorical reveal ('The result?', 'The best part?')",
      "fix": "Cut the theatrical pause and state the outcome directly."
    }
  ]
}
