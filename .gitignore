# Python runtime & environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Node runtime & package managers
node_modules/
.pnpm-store/
.npm/
.next/
out/

# Local state & logs (DEC-071)
data/
.data/
logs/
*.log
*.pid
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Secrets & Local overrides
.env
.env.*
config/config.toml

# OS Metadata
.DS_Store
Thumbs.db

# Obsidian Vault Local State & Workspace Cache (DEC-027 / DEC-070)
.obsidian/
docs/.obsidian/

# Agent runtime artifacts (DEC-122)
core/orchestrator/agents/**/cache/
core/orchestrator/agents/**/logs/
core/orchestrator/agents/**/runtime/
core/orchestrator/agents/**/state/
core/orchestrator/agents/**/kanban/
core/orchestrator/agents/**/plugin-update-checks/
core/orchestrator/agents/**/source-checks/
core/orchestrator/agents/**/*.lock
core/orchestrator/agents/**/gateway*
core/orchestrator/agents/**/spawn-ledger*
core/orchestrator/agents/**/install_id*
