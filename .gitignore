core/orchestrator/agents/**/processes.json*
core/orchestrator/agents/**/cron/admissions/
core/orchestrator/agents/**/cron/catch_up_occurrences
core/orchestrator/agents/**/cron/ticker_*

# Temporary curator backups
**/.curator_backups/
core/orchestrator/agents/**/.curator_backups/

# Local stray files
.wrangler/
*.textClipping

