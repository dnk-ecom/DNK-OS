From: Kuzmenko-top <reburn.craft@gmail.com>
Date: Fri, 6 Nov 2026 20:15:25 +0200
Subject: [PATCH 5/5] feat(normalize): auto-prefix google/ for Gemini models on
 Vertex AI

---
 hermes_cli/model_normalize.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/hermes_cli/model_normalize.py b/hermes_cli/model_normalize.py
index 66dfae00d4..fac3bc80c5 100644
--- a/hermes_cli/model_normalize.py
+++ b/hermes_cli/model_normalize.py
@@ -240,6 +240,11 @@ def normalize_model_for_provider(model_input: str, target_provider: str) -> str:
     if normalized:
         return normalized
 
+    if provider == "vertex":
+        if "/" not in name and name.startswith(("gemini-", "imagen-", "medlm-")):
+            return f"google/{name}"
+        return name
+
     if provider in _STRIP_VENDOR_ONLY_PROVIDERS:
         stripped = _strip_matching_provider_prefix(name, provider)
         if stripped == name and name.startswith(("openai/", "openai:")):
