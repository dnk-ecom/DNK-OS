+def test_compaction_quality_gate_restores_missing_touched_files():
+    from agent.context_compressor import ContextCompressor
+    turns = [
+        {
+            "role": "assistant",
+            "tool_calls": [
+                {
+                    "function": {
+                        "name": "write_file",
+                        "arguments": '{"path": "core/critical_service.py", "content": "..."}'
+                    }
+                }
+            ]
+        }
+    ]
+    incomplete_summary = "## Goal\nRefactor\n\n## Relevant Files\n- path: utils.py | status: read\n\n## Completed Actions\n1. Did stuff"
+    checked = ContextCompressor._compaction_quality_gate(incomplete_summary, turns)
+    assert "core/critical_service.py" in checked
+    assert "touched_in_session" in checked
