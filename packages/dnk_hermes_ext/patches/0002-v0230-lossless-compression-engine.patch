+    @classmethod
+    def _compaction_quality_gate(cls, summary: str, turns_to_summarize: list[dict[str, Any]]) -> str:
+        """Quality Gate (SOTA Invariant from lace/PRI-2943 & Paritok-4b):
+        1. Deterministically verify that modified file paths from the pruned turns are preserved.
+        2. Ensure summary doesn't exceed safety ceilings.
+        """
+        if not summary or not turns_to_summarize:
+            return summary
+
+        touched_files: set[str] = set()
+        for msg in turns_to_summarize:
+            tool_calls = msg.get("tool_calls") or []
+            for tc in tool_calls:
+                fn = getattr(tc, "function", None) or (tc.get("function") if isinstance(tc, dict) else None)
+                if not fn:
+                    continue
+                name = getattr(fn, "name", "") or (fn.get("name") if isinstance(fn, dict) else "")
+                args_str = getattr(fn, "arguments", "") or (fn.get("arguments") if isinstance(fn, dict) else "")
+                if name in ("write_file", "patch", "read_file", "edit_file"):
+                    args = _json_dict(args_str)
+                    path = args.get("path") or args.get("file_path") or args.get("filepath")
+                    if isinstance(path, str) and path.strip() and not path.startswith("http"):
+                        touched_files.add(path.strip())
+
+        if touched_files:
+            missing_files = [f for f in touched_files if f not in summary and Path(f).name not in summary]
+            if missing_files:
+                logger.info("Compaction Quality Gate: restored %d missing touched files to summary: %s",
+                            len(missing_files), missing_files)
+                files_block = "\n".join(f"- path: {f} | status: touched_in_session" for f in sorted(missing_files))
+                if "## Relevant Files" in summary:
+                    summary = summary.replace("## Relevant Files", f"## Relevant Files\n{files_block}")
+                else:
+                    summary += f"\n\n## Relevant Files\n{files_block}"
+
+        return summary
+
     @classmethod
     def _is_context_summary_message(cls, message: Any) -> bool:
         """Return True for summary handoff messages by metadata or content."""
