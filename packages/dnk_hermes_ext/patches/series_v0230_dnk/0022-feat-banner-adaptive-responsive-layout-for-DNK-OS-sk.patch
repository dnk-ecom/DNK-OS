diff --git a/tests/hermes_cli/test_dnk_adaptive_banner.py b/tests/hermes_cli/test_dnk_adaptive_banner.py
new file mode 100644
index 00000000000..72531f9479a
--- /dev/null
+++ b/tests/hermes_cli/test_dnk_adaptive_banner.py
@@ -0,0 +1,70 @@
+import io
+import re
+from rich.console import Console
+from hermes_cli.banner import build_welcome_banner
+from hermes_cli.skin_engine import set_active_skin
+
+
+def test_dnk_banner_standard_width_uses_compact_art():
+    set_active_skin("dnk-os")
+    f = io.StringIO()
+    c = Console(file=f, width=88)
+    build_welcome_banner(
+        console=c,
+        model="google/gemini-4-argon",
+        cwd=".",
+        session_id="test1234",
+        provider="vertex",
+        tools=[],
+    )
+    output = f.getvalue().replace("\u00a0", " ")
+    # At 88 cols, it should use compact art with GERYCH, not wide 46-col art
+    assert "⚡ G E R Y C H ⚡" in output
+    # Check that panel borders close properly
+    lines = [line for line in output.splitlines() if line.strip()]
+    assert lines[0].startswith("╭─")
+    assert lines[-1].startswith("╰─")
+    for line in lines[1:-1]:
+        assert line.startswith("│") and line.endswith("│")
+
+
+def test_dnk_banner_wide_width_uses_wide_art():
+    set_active_skin("dnk-os")
+    f = io.StringIO()
+    c = Console(file=f, width=125)
+    build_welcome_banner(
+        console=c,
+        model="google/gemini-4-argon",
+        cwd=".",
+        session_id="test1234",
+        provider="vertex",
+        tools=[],
+    )
+    output = f.getvalue().replace("\u00a0", " ")
+    # At 125 cols, wide art includes G E R Y C H   C O R E
+    assert "G E R Y C H   C O R E" in output
+    lines = [line for line in output.splitlines() if line.strip()]
+    assert lines[0].startswith("╭─")
+    assert lines[-1].startswith("╰─")
+    for line in lines[1:-1]:
+        assert line.startswith("│") and line.endswith("│")
+
+
+def test_dnk_banner_narrow_width_stack():
+    set_active_skin("dnk-os")
+    f = io.StringIO()
+    c = Console(file=f, width=70)
+    build_welcome_banner(
+        console=c,
+        model="google/gemini-4-argon",
+        cwd=".",
+        session_id="test1234",
+        provider="vertex",
+        tools=[],
+    )
+    output = f.getvalue()
+    lines = [line for line in output.splitlines() if line.strip()]
+    assert lines[0].startswith("╭─")
+    assert lines[-1].startswith("╰─")
+    for line in lines[1:-1]:
+        assert line.startswith("│") and line.endswith("│")
