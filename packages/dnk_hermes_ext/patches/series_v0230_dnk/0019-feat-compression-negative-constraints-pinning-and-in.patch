     demote_stale_tail_tools, lean_tail_budget, is_demoted_stub, skill_view_names_by_call_id, tail_cut_pricer,
@@ -918,6 +925,29 @@ def _reinject_pruned_skill_markers(summary: str, skill_names: list[str]) -> str:
     return summary + _redact_compaction_text("\n\n" + _PRUNED_SKILLS_SECTION_HEADING + "\n" + "\n".join(missing))
 
 
+def _extract_section_content(text: str, heading: str) -> str:
+    """Extract the markdown body under a given heading up to the next heading or end of text."""
+    pattern = rf"(?ms)^{re.escape(heading)}\s*\n(.*?)(?=^## |\Z)"
+    match = re.search(pattern, text)
+    return match.group(1).strip() if match else ""
+
+
+def _reinject_pinned_invariants(summary: str, previous_summary: Optional[str] = None) -> str:
+    """Deterministically restore negative constraints and invariants if the summarizer dropped them."""
+    if not previous_summary or PINNED_INVARIANTS_SECTION_HEADING not in previous_summary:
+        return summary
+    prev_content = _extract_section_content(previous_summary, PINNED_INVARIANTS_SECTION_HEADING)
+    if not prev_content or prev_content.strip() in ("", "None", "None."):
+        return summary
+    curr_content = _extract_section_content(summary, PINNED_INVARIANTS_SECTION_HEADING)
+    if not curr_content or curr_content.strip() in ("", "None", "None."):
+        logger.info("Re-injecting %d chars of dropped pinned invariants into compaction summary", len(prev_content))
+        reconstructed = f"\n\n{PINNED_INVARIANTS_SECTION_HEADING}\n{prev_content.strip()}"
+        return summary + _redact_compaction_text(reconstructed)
+    return summary
+
+
