     assert "[archive: /home/user/.hermes/cache/terminal-output/out-1.log]" in summary2
 
+
+def test_reinject_pinned_invariants_restores_dropped_negative_rules():
+    from agent.context_compressor import _reinject_pinned_invariants
+    previous_summary = (
+        "## Goal\nComplete audit\n\n"
+        "## Pinned Invariants & Negative Constraints\n"
+        "- NEVER create local virtualenvs (use ~/.dnk_runtime/venv)\n"
+        "- NEVER leak credentials or raw API tokens\n\n"
+        "## Completed Actions\n1. Done"
+    )
+    # LLM summarizer dropped the section entirely:
+    amnesic_new_summary = (
+        "## Goal\nComplete audit\n\n"
+        "## Completed Actions\n1. Done\n2. Next action"
+    )
+    restored = _reinject_pinned_invariants(amnesic_new_summary, previous_summary)
+    assert "## Pinned Invariants & Negative Constraints" in restored
+    assert "- NEVER create local virtualenvs (use ~/.dnk_runtime/venv)" in restored
+    assert "- NEVER leak credentials or raw API tokens" in restored
+
