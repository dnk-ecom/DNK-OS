@@ -0,0 +1,103 @@
+"""Vertex AI per-model 429 rate limit cooldown tests.
+
+Ensures that when a Gemini model (e.g. gemini-3.8-flash) hits HTTP 429 on Vertex AI,
+only that model is cooled down in the credential pool, while sibling models
+(gemini-4-argon, gemini-3.7-flash) remain available for immediate in-stream failover.
+"""
+import json
+import time
+import pytest
+
+KEY = "ya29.synthetic-vertex-oauth-token-for-test"
+MODEL_A = "gemini-3.8-flash"
+MODEL_A_PREFIXED = "google/gemini-3.8-flash"
+MODEL_B = "gemini-4-argon"
+MODEL_B_PREFIXED = "google/gemini-4-argon"
+MODEL_C = "gemini-3.7-flash"
+
+
+@pytest.fixture
+def vertex_pool(tmp_path, monkeypatch):
+    root = tmp_path / "hermes-root"
+    root.mkdir()
+    (tmp_path / "fakehome").mkdir()
+    monkeypatch.setenv("HOME", str(tmp_path / "fakehome"))
+    monkeypatch.setenv("VERTEX_API_KEY", KEY)
+    monkeypatch.setenv("VERTEX_PROJECT_ID", "test-project-dnk")
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    import hermes_constants
+    hermes_constants._default_hermes_root_memo = None
+    (root / "auth.json").write_text(json.dumps({"credential_pool": {"vertex": [{
+        "id": "vtx-primary", "label": "VERTEX_API_KEY", "auth_type": "api_key", "priority": 0,
+        "source": "env:VERTEX_API_KEY", "access_token": KEY,
+    }]}}))
+    from agent.credential_pool import load_pool
+    return load_pool("vertex")
+
+
+def test_vertex_429_benches_only_rate_limited_model(vertex_pool):
+    ctx = {"message": "Resource has been exhausted (e.g. check quota). 429 RESOURCE_EXHAUSTED"}
+    
+    # Model A hits 429
+    res = vertex_pool.mark_exhausted_and_rotate(
+        status_code=429,
+        error_context=ctx,
+        api_key_hint=KEY,
+        failure_reason="rate_limit",
+        model=MODEL_A,
+    )
+    assert res is None  # Sole credential cannot rotate to another entry for Model A
+
+    # Credential-wide state is NOT exhausted
+    assert vertex_pool.entries()[0].last_status is None
+
+    # Model A is in cooldown, but Model B and Model C are available
+    assert vertex_pool.select(model=MODEL_A) is None
+    assert vertex_pool.select(model=MODEL_A_PREFIXED) is None
+    assert vertex_pool.select(model=MODEL_B) is not None
+    assert vertex_pool.select(model=MODEL_B_PREFIXED) is not None
+    assert vertex_pool.select(model=MODEL_C) is not None
+
+    # next_available_at checks
+    assert vertex_pool.next_available_at(model=MODEL_A) is not None
+    assert vertex_pool.next_available_at(model=MODEL_B) is None
+
+
+def test_vertex_candidate_pool_exhausted_allows_sibling_models(vertex_pool):
+    from agent.chat_completion_helpers import _candidate_pool_exhausted
+
+    class DummyAgent:
+        _credential_pool = vertex_pool
+
+    agent = DummyAgent()
+
+    # Bench Model A with a long cooldown (>600s)
+    long_ctx = {"reset_at": time.time() + 900}
+    vertex_pool.mark_exhausted_and_rotate(
+        status_code=429,
+        error_context=long_ctx,
+        api_key_hint=KEY,
+        failure_reason="rate_limit",
+        model=MODEL_A_PREFIXED,
+    )
+
+    # Candidate pool for Model A is exhausted due to >600s cooldown
+    assert _candidate_pool_exhausted(agent, "vertex", MODEL_A) is True
+    assert _candidate_pool_exhausted(agent, "vertex", MODEL_A_PREFIXED) is True
+
+    # Candidate pool for Model B and Model C MUST NOT be exhausted
+    assert _candidate_pool_exhausted(agent, "vertex", MODEL_B) is False
+    assert _candidate_pool_exhausted(agent, "vertex", MODEL_B_PREFIXED) is False
+    assert _candidate_pool_exhausted(agent, "vertex", MODEL_C) is False
+
+
+@pytest.mark.parametrize("status_code, failure_reason", [(401, None), (402, "billing"), (429, "billing")])
+def test_vertex_auth_and_billing_failures_stay_credential_wide(vertex_pool, status_code, failure_reason):
+    from agent.credential_pool import STATUS_EXHAUSTED
+
+    vertex_pool.mark_exhausted_and_rotate(
+        status_code=status_code, api_key_hint=KEY, failure_reason=failure_reason, model=MODEL_A,
+    )
+    assert vertex_pool.entries()[0].last_status == STATUS_EXHAUSTED
+    assert not vertex_pool.entries()[0].model_cooldowns
+    assert vertex_pool.select(model=MODEL_B) is None
