         term_width = getattr(console, "_width", None) or getattr(console, "width", None) or shutil.get_terminal_size().columns or 85
         from rich.cells import cell_len
 
+        # Resolve active mode & working directory cleanly
+        target_dir = Path(cwd).resolve() if cwd else Path.cwd()
+        home = Path.home()
+        base_dir = home / "Kuzmenko" / "MY_LIFE_WORK"
+
+        active_mode = os.environ.get("GERYCH_MODE", "").strip().lower()
+        if not active_mode:
+            if target_dir == base_dir:
+                active_mode = "root"
+            elif target_dir == (base_dir / "DNK_HUB"):
+                active_mode = "hub"
+            elif "SHOPIFY" in str(target_dir):
+                active_mode = "shop"
+            else:
+                active_mode = "local"
+
         # Adaptive layout: choose wide hero art on >=120 cols, compact hero art on standard displays (<120)
         is_wide = term_width >= 120
         if is_wide:
             hero_art = getattr(_bskin, "banner_hero", None) or HERMES_CADUCEUS
         else:
             hero_art = getattr(_bskin, "banner_hero_compact", None) or getattr(_bskin, "banner_hero", None) or HERMES_CADUCEUS
+
+        if hero_art and active_mode in ("root", "hub", "shop"):
+            tag = active_mode.upper()
+            hero_art = re.sub(
+                r'⚡[\s\u00a0]*G[\s\u00a0]*E[\s\u00a0]*R[\s\u00a0]*Y[\s\u00a0]*C[\s\u00a0]*H[\s\u00a0]*⚡',
+                f"⚡ G E R Y C H · {tag} ⚡",
+                hero_art
+            )
+            hero_art = re.sub(
+                r'G[\s\u00a0]+E[\s\u00a0]+R[\s\u00a0]+Y[\s\u00a0]+C[\s\u00a0]+H[\s\u00a0]+C[\s\u00a0]+O[\s\u00a0]+R[\s\u00a0]+E',
+                f"G E R Y C H   {tag}",
+                hero_art
+            )
+
         if hero_art:
             hero_art = "\n".join(line.replace(" ", "\u00a0") for line in hero_art.splitlines())
 
         raw_art_lines = [re.sub(r'\[.*?\]', '', line) for line in hero_art.strip().splitlines()]
         art_w = max((cell_len(line) for line in raw_art_lines), default=28)
 
+        # Sizing and layout: snug, balanced width allocation (no awkward dead gaps)
         panel_padding = 1 if term_width >= 86 else 0
         col_padding = 2 if term_width >= 86 else 1
         total_overhead = (panel_padding * 2) + 2 + col_padding
-        available_content_w = max(40, term_width - total_overhead)
 
-        # Balanced width allocation: left column holds art, launch presets, and folder path
-        left_w = max(art_w + col_padding, min(41, available_content_w // 2))
-        max_right_w = max(24, available_content_w - left_w)
+        if is_wide:
+            target_panel_w = min(term_width, 108)
+        else:
+            target_panel_w = min(term_width, 86)
+
+        avail_w = max(40, target_panel_w - total_overhead)
+        left_w = max(art_w + col_padding, avail_w // 2)
+        right_w = avail_w - left_w
         effective_left_w = left_w - col_padding
-        effective_right_w = max_right_w - col_padding
+        effective_right_w = right_w - col_padding
 
         def _fit_line(name: str, desc: str, max_w: int, prefix: str = "  ", sep: str = " — ") -> str:
             overhead = cell_len(prefix) + cell_len(sep)
@@ -872,9 +907,7 @@ def build_welcome_banner(
 
         connected_mcp_count = len([x for x in active_mcps if x[2]])
 
-        # 2. Resolve active working directory cleanly
