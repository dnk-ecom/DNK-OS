+        folder_prefix = "📁 Папка: "
+        avail_path_w = effective_left_w - cell_len(folder_prefix)
         if cell_len(display_dir) > avail_path_w and avail_path_w > 8:
             short_dir = "…" + display_dir[-(avail_path_w - 1):]
         else:
             short_dir = display_dir
-        folder_line = f"[dim {dim}]{folder_prefix}{short_dir}{dir_mode}[/]"
+        folder_line = f"[dim {dim}]{folder_prefix}{short_dir}[/]"
 
-        # 3. CLI Launch Presets
+        # 3. CLI Launch Presets with active mode highlight
         launch_presets = [
-            ("gerych", "локальна папка"),
-            ("gerych root", "вся екосистема"),
-            ("gerych shop", "Shopify розробка"),
-            ("gerych hub", "системне ядро"),
+            ("local", "gerych", "локальна папка"),
+            ("root", "gerych root", "вся екосистема"),
+            ("shop", "gerych shop", "Shopify розробка"),
+            ("hub", "gerych hub", "системне ядро"),
         ]
-        launch_lines = [_fit_line(cmd, desc, effective_left_w) for cmd, desc in launch_presets]
+        launch_lines = []
+        for m_key, cmd, desc in launch_presets:
+            if m_key == active_mode:
+                prefix = "[bold #00FFAA]▶[/] "
+                launch_lines.append(f"{prefix}[bold white]{cmd}[/] [dim {dim}]—[/] [{text}]{desc}[/] [bold #00FFAA]●[/]")
+            else:
+                launch_lines.append(_fit_line(cmd, desc, effective_left_w, prefix="    "))
 
         # 4. Useful commands
         cmd_pool = [
@@ -932,6 +970,7 @@ def build_welcome_banner(
             "",
             f"[{accent}]{model_short}[/] [dim {dim}]·[/] [dim {dim}]{provider_display}[/]",
             f"[dim {dim}]Сесія: {session_id or 'live'}[/]",
+            mode_display_line,
             folder_line,
         ]
         if connected_mcp_count > 0:
@@ -1116,7 +1155,15 @@ def build_welcome_banner(
         )
         version_label = format_banner_version_label()
         v_str = version_label.replace("Hermes Agent ", "Hermes ").replace("Hermes Hermes ", "Hermes ")
-        agent_title = "Denchik (DNK OS)" if is_denchik else "Gerych (DNK OS)"
+        mode_titles = {
+            "root": "Gerych Root (DNK OS)",
+            "hub": "Gerych Hub (DNK OS)",
+            "shop": "Gerych Shop (DNK OS)",
+            "local": "Gerych (DNK OS)",
