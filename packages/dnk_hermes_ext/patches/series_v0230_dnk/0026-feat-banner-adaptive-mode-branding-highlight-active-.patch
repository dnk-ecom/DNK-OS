+        agent_title = mode_titles.get(active_mode, "Gerych (DNK OS)")
+        if is_denchik:
+            agent_title = "Denchik (DNK OS)"
         title_markup = f"[bold {title_color}]{agent_title} · {v_str}[/]"
 
         if term_width < 76:
@@ -1126,6 +1173,7 @@ def build_welcome_banner(
                 hero_art,
                 f"[{accent}]{model_short}[/] [dim {dim}]·[/] [dim {dim}]{provider_display}[/]",
                 f"[dim {dim}]Сесія: {session_id or 'live'}[/]",
+                mode_display_line,
                 folder_line,
                 "",
                 f"[bold {accent}]🚀 Режими:[/] [dim {dim}]gerych · gerych root · gerych shop · gerych hub[/]",
@@ -1146,16 +1194,15 @@ def build_welcome_banner(
 
         dnk_table = Table.grid(padding=(0, col_padding))
         dnk_table.add_column("left", justify="left", no_wrap=True, width=left_w)
-        dnk_table.add_column("right", justify="left", no_wrap=True, width=max_right_w)
+        dnk_table.add_column("right", justify="left", no_wrap=True, width=right_w)
         dnk_table.add_row(left_content, right_content)
 
-        panel_w = min(term_width, left_w + max_right_w + total_overhead)
         outer_panel = Panel(
             dnk_table,
             title=title_markup,
             border_style=border_color,
             padding=(0, panel_padding),
-            width=panel_w,
+            width=target_panel_w,
         )
         console.print()
         console.print(outer_panel)
