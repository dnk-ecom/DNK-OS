From f20bf94c4211ac2e06061bed903bad082cb9b560 Mon Sep 17 00:00:00 2001
From: Kuzmenko-top <reburn.craft@gmail.com>
Date: Wed, 11 Nov 2026 12:40:29 +0200
Subject: [PATCH 24/26] fix(scones): resolve DNK_HUB dynamically regardless of
 CWD

---
 plugins/memory/scones/__init__.py | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/plugins/memory/scones/__init__.py b/plugins/memory/scones/__init__.py
index a9800fed6c3..e8ad4025eda 100644
--- a/plugins/memory/scones/__init__.py
+++ b/plugins/memory/scones/__init__.py
@@ -35,10 +35,18 @@ logger = logging.getLogger(__name__)
 
 # Find DNK_HUB root dynamically by searching upwards for .scones or AGENTS.md
 def _find_hub_root() -> Path:
+    hub_env = os.environ.get("DNK_HUB_PATH") or os.environ.get("DNK_HUB_ROOT")
+    if hub_env and Path(hub_env).exists():
+        return Path(hub_env)
+    candidate = Path.home() / "Kuzmenko" / "MY_LIFE_WORK" / "DNK_HUB"
+    if candidate.exists():
+        return candidate
     cur = Path(__file__).resolve().parent
     for p in [cur] + list(cur.parents):
-        if (p / ".scones").exists() or (p / "AGENTS.md").exists():
+        if (p / ".scones").exists() or (p / "AGENTS.md").exists() or (p / "core").exists():
             return p
+        if (p / "DNK_HUB").exists():
+            return p / "DNK_HUB"
     return cur.parents[5]
 
 _HUB_ROOT = _find_hub_root()
-- 
