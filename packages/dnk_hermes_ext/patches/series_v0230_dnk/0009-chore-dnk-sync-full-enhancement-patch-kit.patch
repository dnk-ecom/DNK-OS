 1 file changed, 166 insertions(+), 1 deletion(-)

diff --git a/dnk_patches/dnk_os_full_hermes_v0230.patch b/dnk_patches/dnk_os_full_hermes_v0230.patch
index 45b938485f3..2ec7174af0a 100644
