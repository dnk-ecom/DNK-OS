+# --- DNK-MRH-HEADER ---
+# mrh_id: "plugins/google-vertex-media/tools.py"
+# purpose: "Direct tool schemas and execution handlers for Google Cloud Imagen 3/4 and Veo 3.1."
+# canonical_source: true
+# alters_files: []
+# triggers_tasks: []
+# status: "Active"
+# version: "1.0.0"
+# updated_at: "2026-11-08"
+# --- END DNK-MRH-HEADER ---
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any
+
+try:
+    from .client import (
+        DEFAULT_IMAGEN_MODEL,
+        DEFAULT_VEO_MODEL,
+        VertexMediaAPIError,
+        VertexMediaAuthError,
+        VertexMediaClient,
+    )
+except (ImportError, ValueError):
+    from client import (  # type: ignore
+        DEFAULT_IMAGEN_MODEL,
+        DEFAULT_VEO_MODEL,
+        VertexMediaAPIError,
+        VertexMediaAuthError,
+        VertexMediaClient,
+    )
+
+logger = logging.getLogger("hermes.plugins.vertex_media.tools")
+
+_client_instance: VertexMediaClient | None = None
+
+
+def _get_client() -> VertexMediaClient:
+    global _client_instance
+    if _client_instance is None:
+        _client_instance = VertexMediaClient()
+    return _client_instance
+
+
+# -----------------------------------------------------------------------------
+# Tool: google_imagen
+# -----------------------------------------------------------------------------
+GOOGLE_IMAGEN_SCHEMA = {
+    "name": "google_imagen",
+    "description": (
+        "Generate high-resolution professional images using Google Cloud Vertex AI Imagen 3 / Imagen 4. "
+        "Supports studio product photography, photorealistic scenes, typography, and concept art."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "prompt": {
+                "type": "string",
+                "description": "Detailed text description of the image to generate.",
+            },
+            "model": {
+                "type": "string",
+                "description": "Model ID to use. Defaults to 'imagen-3.0-generate-002'. Options: 'imagen-3.0-generate-002', 'imagen-4.0-generate-001', 'imagen-4.0-fast-generate-001'.",
+                "default": DEFAULT_IMAGEN_MODEL,
+            },
+            "aspect_ratio": {
+                "type": "string",
+                "description": "Output aspect ratio. Supported: '1:1' (square), '16:9' (landscape), '9:16' (portrait/story), '4:3', '3:4'.",
+                "default": "1:1",
+                "enum": ["1:1", "16:9", "9:16", "4:3", "3:4"],
+            },
+            "number_of_images": {
+                "type": "integer",
+                "description": "Number of images to generate (1 to 4). Defaults to 1.",
+                "default": 1,
+                "minimum": 1,
+                "maximum": 4,
+            },
+            "negative_prompt": {
+                "type": "string",
+                "description": "Elements or artifacts to avoid in the generation.",
+            },
+        },
+        "required": ["prompt"],
+    },
+}
+
+
+def handle_google_imagen(args: dict[str, Any], **kwargs: Any) -> str:
+    """Execute direct Google Imagen generation."""
+    prompt = args.get("prompt", "").strip()
+    if not prompt:
+        return json.dumps({"success": False, "error": "Prompt must not be empty."})
+
+    model = args.get("model") or DEFAULT_IMAGEN_MODEL
+    aspect_ratio = args.get("aspect_ratio") or "1:1"
+    number_of_images = int(args.get("number_of_images") or 1)
+    negative_prompt = args.get("negative_prompt")
+
+    client = _get_client()
+    try:
+        res = client.generate_image(
+            prompt=prompt,
+            model=model,
+            aspect_ratio=aspect_ratio,
+            number_of_images=number_of_images,
+            negative_prompt=negative_prompt,
+        )
+        return json.dumps(res, indent=2)
+    except (VertexMediaAuthError, VertexMediaAPIError) as e:
+        return json.dumps({"success": False, "error": str(e)})
+    except Exception as e:  # health: allow BLE001 -- tool execution error boundary
+        logger.exception("google_imagen execution error")
+        return json.dumps({"success": False, "error": f"Internal execution error: {e}"})
+
+
+# -----------------------------------------------------------------------------
+# Tool: google_veo
+# -----------------------------------------------------------------------------
+GOOGLE_VEO_SCHEMA = {
+    "name": "google_veo",
+    "description": (
+        "Generate cinematic, high-definition videos with native synchronized audio using Google Cloud Vertex AI Veo 3.1. "
+        "Supports Text-to-Video and Image-to-Video with realistic physics and camera movement controls."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "prompt": {
+                "type": "string",
+                "description": (
+                    "Text prompt describing scene, action, visual style, and camera movement "
+                    "(e.g., 'dolly shot', 'drone shot', 'macro lens', 'golden hour')."
+                ),
+            },
+            "model": {
+                "type": "string",
+                "description": "Veo model ID. Defaults to 'veo-3.1-generate-001'. Options: 'veo-3.1-generate-001', 'veo-3.1-fast-generate-001', 'veo-2.0-generate-001'.",
+                "default": DEFAULT_VEO_MODEL,
+            },
+            "image_url": {
+                "type": "string",
+                "description": "Optional local file path or HTTP URL for starting frame (Image-to-Video).",
+            },
+            "aspect_ratio": {
+                "type": "string",
+                "description": "Output aspect ratio. Supported: '16:9' (landscape), '9:16' (vertical/reels).",
+                "default": "16:9",
+                "enum": ["16:9", "9:16"],
+            },
+            "resolution": {
+                "type": "string",
+                "description": "Video resolution. Options: '720p', '1080p', '4k'. Defaults to '720p'.",
+                "default": "720p",
+                "enum": ["720p", "1080p", "4k"],
+            },
+            "duration": {
+                "type": "integer",
+                "description": "Duration in seconds (Veo 3.1 supports 4, 6, or 8 seconds). Defaults to 6.",
+                "default": 6,
+                "enum": [4, 6, 8],
+            },
+            "audio": {
+                "type": "boolean",
+                "description": "Generate synchronized background audio and sound effects. Defaults to true.",
+                "default": True,
+            },
+            "negative_prompt": {
+                "type": "string",
+                "description": "Content, styles, or camera jitter to avoid.",
+            },
+        },
+        "required": ["prompt"],
+    },
+}
+
+
+def handle_google_veo(args: dict[str, Any], **kwargs: Any) -> str:
+    """Execute direct Google Veo video generation."""
+    prompt = args.get("prompt", "").strip()
+    if not prompt:
+        return json.dumps({"success": False, "error": "Prompt must not be empty."})
+
+    model = args.get("model") or DEFAULT_VEO_MODEL
+    image_url = args.get("image_url")
+    aspect_ratio = args.get("aspect_ratio") or "16:9"
+    resolution = args.get("resolution") or "720p"
+    duration = int(args.get("duration") or 6)
+    audio = True if args.get("audio") is None else bool(args.get("audio"))
+    negative_prompt = args.get("negative_prompt")
+
+    client = _get_client()
+    try:
+        res = client.generate_video(
+            prompt=prompt,
+            model=model,
+            image_url=image_url,
+            aspect_ratio=aspect_ratio,
+            resolution=resolution,
+            duration_seconds=duration,
+            generate_audio=audio,
+            negative_prompt=negative_prompt,
+        )
+        return json.dumps(res, indent=2)
+    except (VertexMediaAuthError, VertexMediaAPIError) as e:
+        return json.dumps({"success": False, "error": str(e)})
+    except Exception as e:  # health: allow BLE001 -- tool execution error boundary
+        logger.exception("google_veo execution error")
+        return json.dumps({"success": False, "error": f"Internal execution error: {e}"})
+
+
+MEDIA_TOOLS = [
