+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, List, Optional
+
+from agent.video_gen_provider import (
+    COMMON_ASPECT_RATIOS,
+    COMMON_RESOLUTIONS,
+    DEFAULT_ASPECT_RATIO,
+    DEFAULT_RESOLUTION,
+    VideoGenProvider,
+    error_response,
+    success_response,
+)
+
+try:
+    from .client import (
+        DEFAULT_VEO_MODEL,
+        VertexMediaAPIError,
+        VertexMediaAuthError,
+        VertexMediaClient,
+    )
+except (ImportError, ValueError):
+    from client import (  # type: ignore
+        DEFAULT_VEO_MODEL,
+        VertexMediaAPIError,
+        VertexMediaAuthError,
+        VertexMediaClient,
+    )
+
+logger = logging.getLogger("hermes.plugins.vertex_media.video_provider")
+
+
+class GoogleVertexVideoGenProvider(VideoGenProvider):
+    """Google Vertex AI (Veo 3.1 / Veo 2.0) video generation backend for Hermes."""
+
+    def __init__(self, client: Optional[VertexMediaClient] = None) -> None:
+        self._client = client or VertexMediaClient()
+
+    @property
+    def name(self) -> str:
+        return "vertex"
+
+    @property
+    def display_name(self) -> str:
+        return "Google Vertex AI (Veo)"
+
+    def is_available(self) -> bool:
+        """Check if Vertex AI credentials or project are present."""
+        try:
+            from agent.vertex_adapter import has_vertex_credentials
+            if has_vertex_credentials():
+                return True
+        except (ImportError, KeyError, AttributeError, OSError):
+            pass
+
+        import os
+        return bool(
+            os.environ.get("GOOGLE_APPLICATION_CREDENTIALS")
+            or os.environ.get("VERTEX_BEARER_TOKEN")
+            or os.environ.get("GOOGLE_CLOUD_PROJECT")
+            or os.environ.get("GCP_PROJECT")
+        )
+
+    def list_models(self) -> list[dict[str, Any]]:
+        return [
+            {
+                "id": "veo-3.1-generate-001",
+                "display": "Veo 3.1 (Cinematic SOTA + Native Audio)",
+                "speed": "~60-90s",
+                "strengths": "Deep language understanding, lighting/physics, cinematic camera, native audio",
+            },
+            {
+                "id": "veo-3.1-fast-generate-001",
+                "display": "Veo 3.1 Fast (Low-latency)",
+                "speed": "~30-45s",
+                "strengths": "High throughput, cost-effective, optimized for ads and social media",
+            },
+            {
+                "id": "veo-2.0-generate-001",
+                "display": "Veo 2.0 (Legacy)",
+                "speed": "~60s",
+                "strengths": "Previous generation video model (no audio)",
+            },
+        ]
+
+    def default_model(self) -> Optional[str]:
+        return DEFAULT_VEO_MODEL
+
+    def capabilities(self) -> dict[str, Any]:
+        return {
+            "modalities": ["text", "image"],
+            "aspect_ratios": ["16:9", "9:16"],
+            "resolutions": ["720p", "1080p", "4k"],
+            "max_duration": 8,
+            "min_duration": 4,
+            "supports_audio": True,
+            "supports_negative_prompt": True,
+            "max_reference_images": 1,
+        }
+
+    def generate(
+        self,
+        prompt: str,
+        *,
+        model: Optional[str] = None,
+        image_url: Optional[str] = None,
+        reference_image_urls: Optional[list[str]] = None,
+        duration: Optional[int] = None,
+        aspect_ratio: str = DEFAULT_ASPECT_RATIO,
+        resolution: str = DEFAULT_RESOLUTION,
+        negative_prompt: Optional[str] = None,
+        audio: Optional[bool] = None,
+        seed: Optional[int] = None,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        target_model = model or DEFAULT_VEO_MODEL
+        target_duration = duration if duration in (4, 6, 8) else 6
+        target_audio = True if audio is None else bool(audio)
+        effective_image = image_url or (reference_image_urls[0] if reference_image_urls else None)
+
+        try:
+            result = self._client.generate_video(
+                prompt=prompt,
+                model=target_model,
+                image_url=effective_image,
+                aspect_ratio=aspect_ratio,
+                resolution=resolution,
+                duration_seconds=target_duration,
+                generate_audio=target_audio,
+                negative_prompt=negative_prompt,
+            )
+            return success_response(
+                video=result["video"],
+                model=result["model"],
+                prompt=result["prompt"],
+                modality=result.get("modality", "text"),
+                aspect_ratio=aspect_ratio,
+                duration=target_duration,
+                provider=self.name,
+                extra=result.get("metadata"),
+            )
+        except VertexMediaAuthError as e:
+            return error_response(
+                prompt=prompt,
+                model=target_model,
+                provider=self.name,
+                error=f"Google Vertex AI authentication error: {e}",
+                error_type="auth_error",
+            )
+        except VertexMediaAPIError as e:
+            return error_response(
+                prompt=prompt,
+                model=target_model,
+                provider=self.name,
+                error=f"Google Vertex AI API error: {e}",
+                error_type="api_error",
+            )
+        except Exception as e:
+            logger.exception("Unexpected error in Vertex video generation")
+            return error_response(
+                prompt=prompt,
+                model=target_model,
+                provider=self.name,
+                error=f"Unexpected error: {e}",
+                error_type="internal_error",
+            )
