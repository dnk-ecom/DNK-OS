+
+from __future__ import annotations
+
+import json
+import logging
+from http.server import BaseHTTPRequestHandler, HTTPServer
+from typing import Any, Callable
+
+try:
+    from .client import VertexMediaClient
+    from .tools import GOOGLE_IMAGEN_SCHEMA, GOOGLE_VEO_SCHEMA, handle_google_imagen, handle_google_veo
+except (ImportError, ValueError):
+    from client import VertexMediaClient  # type: ignore
+    from tools import GOOGLE_IMAGEN_SCHEMA, GOOGLE_VEO_SCHEMA, handle_google_imagen, handle_google_veo  # type: ignore
+
+logger = logging.getLogger("hermes.plugins.vertex_media.harness")
+
+
+# =============================================================================
+# 1. Multi-Harness Tool Schema Exporters
+# =============================================================================
+
+def to_openai_tools() -> list[dict[str, Any]]:
+    """Export tool schemas for OpenAI Chat Completions API / LiteLLM / Ollama."""
+    return [
+        {
+            "type": "function",
+            "function": {
+                "name": GOOGLE_IMAGEN_SCHEMA["name"],
+                "description": GOOGLE_IMAGEN_SCHEMA["description"],
+                "parameters": GOOGLE_IMAGEN_SCHEMA["parameters"],
+            },
+        },
+        {
+            "type": "function",
+            "function": {
+                "name": GOOGLE_VEO_SCHEMA["name"],
+                "description": GOOGLE_VEO_SCHEMA["description"],
+                "parameters": GOOGLE_VEO_SCHEMA["parameters"],
+            },
+        },
+    ]
+
+
+def to_anthropic_tools() -> list[dict[str, Any]]:
+    """Export tool schemas for Anthropic Claude Tools API."""
+    return [
+        {
+            "name": GOOGLE_IMAGEN_SCHEMA["name"],
+            "description": GOOGLE_IMAGEN_SCHEMA["description"],
+            "input_schema": GOOGLE_IMAGEN_SCHEMA["parameters"],
+        },
+        {
+            "name": GOOGLE_VEO_SCHEMA["name"],
+            "description": GOOGLE_VEO_SCHEMA["description"],
+            "input_schema": GOOGLE_VEO_SCHEMA["parameters"],
+        },
+    ]
+
+
+def to_langchain_tools() -> list[Any]:
+    """Export tools as LangChain StructuredTool instances (if langchain is installed)."""
+    try:
+        from langchain_core.tools import StructuredTool  # type: ignore
+        tools = [
+            StructuredTool.from_function(
+                func=lambda **kwargs: json.loads(handle_google_imagen(kwargs)),
+                name=GOOGLE_IMAGEN_SCHEMA["name"],
+                description=GOOGLE_IMAGEN_SCHEMA["description"],
+            ),
+            StructuredTool.from_function(
+                func=lambda **kwargs: json.loads(handle_google_veo(kwargs)),
+                name=GOOGLE_VEO_SCHEMA["name"],
+                description=GOOGLE_VEO_SCHEMA["description"],
+            ),
+        ]
+        return tools
+    except ImportError:
+        logger.info("langchain_core is not installed; returning standard python callable dictionaries")
+        return [
+            {
+                "name": GOOGLE_IMAGEN_SCHEMA["name"],
+                "description": GOOGLE_IMAGEN_SCHEMA["description"],
+                "func": lambda **kwargs: json.loads(handle_google_imagen(kwargs)),
+            },
+            {
+                "name": GOOGLE_VEO_SCHEMA["name"],
+                "description": GOOGLE_VEO_SCHEMA["description"],
+                "func": lambda **kwargs: json.loads(handle_google_veo(kwargs)),
+            },
+        ]
+
+
+def to_crewai_tools() -> list[Any]:
+    """Export tools for CrewAI agent integration."""
+    try:
+        from crewai.tools import tool  # type: ignore
+
+        @tool("Google Imagen Generator")
+        def crewai_imagen(prompt: str, aspect_ratio: str = "1:1", model: str = "imagen-3.0-generate-002") -> str:
+            """Generate high-resolution product photos and artwork using Google Imagen."""
+            return handle_google_imagen({"prompt": prompt, "aspect_ratio": aspect_ratio, "model": model})
+
+        @tool("Google Veo Video Creator")
+        def crewai_veo(prompt: str, aspect_ratio: str = "16:9", resolution: str = "720p", duration: int = 6) -> str:
+            """Generate realistic cinematic videos with audio using Google Veo 3.1."""
+            return handle_google_veo({"prompt": prompt, "aspect_ratio": aspect_ratio, "resolution": resolution, "duration": duration})
+
+        return [crewai_imagen, crewai_veo]
+    except ImportError:
+        logger.info("crewai is not installed; returning dictionary functions")
+        return to_langchain_tools()
+
+
+# =============================================================================
+# 2. Universal Tool Dispatcher
+# =============================================================================
+
+def dispatch_tool(tool_name: str, arguments: str | dict[str, Any]) -> dict[str, Any]:
+    """Universal dispatch endpoint for any agent harness calling our tools.
+
+    Args:
+        tool_name: 'google_imagen' or 'google_veo'.
+        arguments: Arguments dictionary or JSON-encoded string.
+
+    Returns:
+        Structured result dictionary.
+    """
+    if isinstance(arguments, str):
+        try:
+            args = json.loads(arguments)
+        except json.JSONDecodeError as err:
+            return {"success": False, "error": f"Invalid JSON arguments: {err}"}
+    else:
+        args = arguments or {}
+
+    if tool_name in ("google_imagen", "imagen_generate", "image_generate"):
+        res_str = handle_google_imagen(args)
+        return json.loads(res_str)
+    elif tool_name in ("google_veo", "veo_generate", "video_generate"):
+        res_str = handle_google_veo(args)
+        return json.loads(res_str)
+    else:
+        return {"success": False, "error": f"Unknown tool '{tool_name}'. Available: google_imagen, google_veo."}
+
+
+# =============================================================================
+# 3. Standalone Zero-Dependency HTTP Bridge Server
+# =============================================================================
+
+class HarnessBridgeHTTPHandler(BaseHTTPRequestHandler):
+    """Zero-dependency HTTP server bridge for curl, webhooks, or external microservices."""
+
+    def _send_json(self, status_code: int, data: dict[str, Any]) -> None:
+        payload = json.dumps(data, indent=2).encode("utf-8")
+        self.send_response(status_code)
+        self.send_header("Content-Type", "application/json; charset=utf-8")
+        self.send_header("Content-Length", str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+    def do_GET(self) -> None:
+        if self.path in ("/health", "/v1/health", "/status"):
+            client = VertexMediaClient()
+            try:
+                _, proj, reg = client.resolve_credentials()
+                self._send_json(200, {
+                    "status": "healthy",
+                    "project_id": proj,
+                    "region": reg,
+                    "supported_models": {
+                        "images": ["imagen-3.0-generate-002", "imagen-4.0-generate-001", "imagen-4.0-fast-generate-001"],
+                        "videos": ["veo-3.1-generate-001", "veo-3.1-fast-generate-001", "veo-2.0-generate-001"],
+                    },
+                })
+            except Exception as e:  # health: allow BLE001 -- HTTP bridge error boundary
+                self._send_json(500, {"status": "unhealthy", "error": str(e)})
+        elif self.path == "/v1/tools":
+            self._send_json(200, {"openai_tools": to_openai_tools(), "anthropic_tools": to_anthropic_tools()})
+        else:
+            self._send_json(404, {"error": f"Path '{self.path}' not found."})
+
+    def do_POST(self) -> None:
+        content_len = int(self.headers.get("Content-Length", 0))
+        raw_body = self.rfile.read(content_len).decode("utf-8") if content_len > 0 else "{}"
+        try:
+            body = json.loads(raw_body)
+        except Exception as e:  # health: allow BLE001 -- HTTP bridge error boundary
+            self._send_json(400, {"error": f"Invalid JSON payload: {e}"})
+            return
+
+        if self.path in ("/v1/images/generations", "/v1/imagen"):
+            prompt = body.get("prompt", "")
+            size = body.get("size", "1024x1024")
+            ratio = "16:9" if size == "1792x1024" else ("9:16" if size == "1024x1792" else "1:1")
+            result = dispatch_tool("google_imagen", {
+                "prompt": prompt,
+                "model": body.get("model", "imagen-3.0-generate-002"),
+                "aspect_ratio": body.get("aspect_ratio", ratio),
+                "number_of_images": body.get("n", 1),
+            })
+            self._send_json(200 if result.get("success") else 500, result)
+
+        elif self.path in ("/v1/videos/generations", "/v1/veo"):
+            result = dispatch_tool("google_veo", body)
+            self._send_json(200 if result.get("success") else 500, result)
+
+        elif self.path == "/v1/tools/call":
+            tool_name = body.get("tool", body.get("name", ""))
+            args = body.get("arguments", body.get("args", {}))
+            result = dispatch_tool(tool_name, args)
+            self._send_json(200 if result.get("success") else 500, result)
+
+        else:
+            self._send_json(404, {"error": f"Endpoint '{self.path}' not supported."})
+
+
+def serve_harness_bridge(host: str = "127.0.0.1", port: int = 8190) -> None:
+    """Run a local HTTP microservice bridge so other harnesses can invoke Google Vertex Media."""
+    server = HTTPServer((host, port), HarnessBridgeHTTPHandler)
+    logger.info("Google Vertex Media Harness Bridge serving at http://%s:%d", host, port)
+    print(f"Vertex Media Bridge active at http://{host}:{port} (GET /v1/tools, POST /v1/images/generations, POST /v1/videos/generations)")
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        logger.info("Bridge stopped by user.")
+    finally:
+        server.server_close()
