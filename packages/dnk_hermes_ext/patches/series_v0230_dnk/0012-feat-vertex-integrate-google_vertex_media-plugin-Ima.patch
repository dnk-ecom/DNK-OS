+# --- DNK-MRH-HEADER ---
+# mrh_id: "plugins/google-vertex-media/cli.py"
+# purpose: "CLI command handlers for 'hermes vertex-media' (generate, test-auth, export-harness, install-user)."
+# canonical_source: true
+# alters_files: []
+# triggers_tasks: []
+# status: "Active"
+# version: "1.0.0"
