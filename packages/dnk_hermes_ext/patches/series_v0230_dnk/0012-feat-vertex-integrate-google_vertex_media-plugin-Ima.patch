+"""Google Cloud Vertex Media Plugin for Hermes Agent.
+
+Provides:
+- GoogleVertexImageGenProvider for 'image_generate' tool (Imagen 3 / 4)
+- GoogleVertexVideoGenProvider for 'video_generate' tool (Veo 3.1)
+- Direct tools: 'google_imagen' and 'google_veo'
+- CLI commands: 'hermes vertex-media'
+- Multi-harness reverse engineering exports: OpenAI, Anthropic, LangChain, CrewAI, AutoGen
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+from .cli import handle_vertex_media_cli, register_vertex_media_cli
+from .client import VertexMediaClient
+from .image_provider import GoogleVertexImageGenProvider
+from .tools import MEDIA_TOOLS
+from .video_provider import GoogleVertexVideoGenProvider
+
+logger = logging.getLogger("hermes.plugins.vertex_media")
+
+
+def register(ctx: Any) -> None:
+    """Register ImageGenProvider, VideoGenProvider, direct tools, and CLI commands."""
+    logger.info("Registering Google Cloud Vertex Media plugin...")
+
+    # 1. Register Image Generation Provider for 'image_generate' tool
+    if hasattr(ctx, "register_image_gen_provider"):
+        try:
+            ctx.register_image_gen_provider(GoogleVertexImageGenProvider())
+            logger.debug("Registered GoogleVertexImageGenProvider ('vertex')")
+        except Exception as e:  # health: allow BLE001 -- graceful registration fallback
+            logger.warning("Failed to register GoogleVertexImageGenProvider: %s", e)
+
+    # 2. Register Video Generation Provider for 'video_generate' tool
+    if hasattr(ctx, "register_video_gen_provider"):
+        try:
+            ctx.register_video_gen_provider(GoogleVertexVideoGenProvider())
+            logger.debug("Registered GoogleVertexVideoGenProvider ('vertex')")
+        except Exception as e:  # health: allow BLE001 -- graceful registration fallback
+            logger.warning("Failed to register GoogleVertexVideoGenProvider: %s", e)
+
+    # 3. Register standalone direct tools (google_imagen, google_veo)
+    if hasattr(ctx, "register_tool"):
+        for name, schema, handler, emoji in MEDIA_TOOLS:
+            try:
+                ctx.register_tool(
+                    name=name,
+                    toolset="google_vertex_media",
+                    schema=schema,
+                    handler=handler,
+                    emoji=emoji,
+                    description=schema.get("description", ""),
+                )
+                logger.debug("Registered standalone tool: %s", name)
+            except Exception as e:  # health: allow BLE001 -- graceful registration fallback
+                logger.warning("Failed to register tool %s: %s", name, e)
+
+    # 4. Register CLI command: 'hermes vertex-media'
+    if hasattr(ctx, "register_cli_command"):
+        try:
+            ctx.register_cli_command(
+                name="vertex-media",
+                help="Google Cloud Vertex AI media generation (Imagen 3/4 & Veo 3.1)",
+                setup_fn=register_vertex_media_cli,
+                handler_fn=handle_vertex_media_cli,
+                description=(
+                    "Generate high-resolution images (Imagen 3/4) and cinematic videos (Veo 3.1), "
+                    "verify Google Cloud credentials, and export adapters for external agent harnesses."
+                ),
+            )
+            logger.debug("Registered CLI command: hermes vertex-media")
+        except Exception as e:  # health: allow BLE001 -- graceful registration fallback
+            logger.warning("Failed to register CLI command vertex-media: %s", e)
+
+    logger.info("Google Cloud Vertex Media plugin registered successfully.")
