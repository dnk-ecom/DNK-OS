+
+from __future__ import annotations
+
+import argparse
+import json
+import logging
+import shutil
+import sys
+from pathlib import Path
+from typing import Any, Optional
+
+try:
+    from .client import DEFAULT_IMAGEN_MODEL, DEFAULT_VEO_MODEL, VertexMediaClient
+    from .harness import serve_harness_bridge, to_anthropic_tools, to_openai_tools
+except (ImportError, ValueError):
+    from client import DEFAULT_IMAGEN_MODEL, DEFAULT_VEO_MODEL, VertexMediaClient  # type: ignore
+    from harness import serve_harness_bridge, to_anthropic_tools, to_openai_tools  # type: ignore
+
+logger = logging.getLogger("hermes.plugins.vertex_media.cli")
+
+
+def register_vertex_media_cli(subparser: argparse.ArgumentParser) -> None:
+    """Setup arguments for 'hermes vertex-media'."""
+    cmd_subs = subparser.add_subparsers(dest="vertex_subcommand", help="Vertex Media subcommands")
+
+    # 1. status
+    cmd_subs.add_parser("status", help="Check Google Cloud Vertex AI credentials, project, and connectivity")
+
+    # 2. image
+    img_parser = cmd_subs.add_parser("image", help="Generate an image using Imagen 3 / 4")
+    img_parser.add_argument("prompt", help="Text description of the image")
+    img_parser.add_argument("--model", default=DEFAULT_IMAGEN_MODEL, help="Imagen model ID")
+    img_parser.add_argument("--aspect-ratio", default="1:1", choices=["1:1", "16:9", "9:16", "4:3", "3:4"])
+    img_parser.add_argument("-n", "--number", type=int, default=1, help="Number of images (1-4)")
+    img_parser.add_argument("--negative-prompt", help="Elements to avoid")
+
+    # 3. video
+    vid_parser = cmd_subs.add_parser("video", help="Generate a video using Veo 3.1")
+    vid_parser.add_argument("prompt", help="Text description and camera direction")
+    vid_parser.add_argument("--model", default=DEFAULT_VEO_MODEL, help="Veo model ID")
+    vid_parser.add_argument("--image", help="Starting frame path or URL (Image-to-Video)")
+    vid_parser.add_argument("--aspect-ratio", default="16:9", choices=["16:9", "9:16"])
+    vid_parser.add_argument("--resolution", default="720p", choices=["720p", "1080p", "4k"])
+    vid_parser.add_argument("--duration", type=int, default=6, choices=[4, 6, 8], help="Duration in seconds")
+    vid_parser.add_argument("--no-audio", action="store_true", help="Disable audio synthesis")
+    vid_parser.add_argument("--negative-prompt", help="Elements to avoid")
+
+    # 4. export
+    exp_parser = cmd_subs.add_parser("export", help="Export tool schemas for other harnesses (OpenAI, Anthropic)")
+    exp_parser.add_argument("--format", choices=["openai", "anthropic"], default="openai", help="Output schema standard")
+
+    # 5. serve
+    srv_parser = cmd_subs.add_parser("serve", help="Run local HTTP bridge server for external agent harnesses")
+    srv_parser.add_argument("--host", default="127.0.0.1", help="Host interface")
+    srv_parser.add_argument("--port", type=int, default=8190, help="Port to listen on")
+
+    # 6. install-user
+    cmd_subs.add_parser("install-user", help="Copy plugin to ~/.hermes/plugins/ so it survives repository updates")
+
+
+_SUBCOMMAND_HANDLERS = {
+    "status": lambda args: _handle_status(),
+    "image": lambda args: _handle_image(args),
+    "video": lambda args: _handle_video(args),
+    "export": lambda args: _handle_export(args),
+    "serve": lambda args: _handle_serve(args),
+    "install-user": lambda args: _handle_install_user(),
+}
+
+
