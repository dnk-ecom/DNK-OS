+# --- DNK-MRH-HEADER ---
+# mrh_id: "plugins/google-vertex-media/client.py"
+# purpose: "Standalone, zero-overhead Google Cloud Vertex AI Media Client for Imagen 3/4 and Veo 3.1."
+# canonical_source: true
+# alters_files: []
+# triggers_tasks: []
+# status: "Active"
+# version: "1.0.0"
+# updated_at: "2026-11-08"
+# --- END DNK-MRH-HEADER ---
+
+from __future__ import annotations
+
+import base64
+import json
+import logging
+import os
+import subprocess
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple, Union
+
+logger = logging.getLogger("hermes.plugins.vertex_media.client")
+
+DEFAULT_REGION = "us-central1"
+DEFAULT_IMAGEN_MODEL = "imagen-3.0-generate-002"
+DEFAULT_VEO_MODEL = "veo-3.1-generate-001"
+
+
+class VertexMediaAuthError(RuntimeError):
+    """Raised when Vertex AI credentials or project cannot be resolved."""
+
+
+class VertexMediaAPIError(RuntimeError):
+    """Raised when Vertex AI returns an API error."""
+    def __init__(self, message: str, status_code: Optional[int] = None, details: Optional[Any] = None) -> None:
+        super().__init__(message)
+        self.status_code = status_code
+        self.details = details
+
+
+class VertexMediaClient:
+    """Core Google Cloud Vertex AI Client for Imagen (Image) and Veo (Video).
+    
+    Operates in two modes:
+    1. Native Hermes runtime: Leverages ``agent.vertex_adapter`` for seamless token caching.
+    2. Decoupled / External harness: Resolves credentials via ``google.auth``, ADC, service account
+       JSON, or ``gcloud auth print-access-token`` for complete portability.
+    """
+
+    def __init__(
+        self,
+        project_id: str | None = None,
+        region: str | None = None,
+        credentials_path: str | None = None,
+        bearer_token: str | None = None,
+        cache_dir: str | Path | None = None,
+    ) -> None:
+        self._project_id = project_id
+        env_region = os.environ.get("VERTEX_MEDIA_REGION") or (
+            os.environ.get("VERTEX_REGION") if os.environ.get("VERTEX_REGION") != "global" else None
+        )
+        self._region = region or env_region or DEFAULT_REGION
+        self._credentials_path = credentials_path or os.environ.get("GOOGLE_APPLICATION_CREDENTIALS")
+        self._bearer_token = bearer_token or os.environ.get("VERTEX_BEARER_TOKEN")
+        self._cache_dir = Path(cache_dir) if cache_dir else self._resolve_default_cache_dir()
+
+    def _resolve_default_cache_dir(self) -> Path:
+        """Resolve caching directory under Hermes Home or local cache."""
+        try:
+            from hermes_constants import get_hermes_home
+            return get_hermes_home() / "cache" / "generated"
+        except ImportError:
+            return Path.home() / ".cache" / "vertex_media"
+
+    def resolve_credentials(self, force_refresh: bool = False) -> tuple[str, str, str]:
+        """Resolve (token, project_id, region).
+        
+        Returns:
+            Tuple of (access_token, project_id, region)
+        """
+        token = self._bearer_token
+        project_id = self._project_id
+        region = self._region
+
+        # 1. Hermes internal adapter path
+        if not token or not project_id:
+            try:
+                from agent.vertex_adapter import get_vertex_credentials, _resolve_region
+                adapter_token, adapter_project = get_vertex_credentials(
+                    credentials_path=self._credentials_path,
+                    force_refresh=force_refresh,
+                )
+                if adapter_token:
+                    token = token or adapter_token
+                if adapter_project:
+                    project_id = project_id or adapter_project
+                resolved_reg = _resolve_region(region)
+                if resolved_reg and resolved_reg != "global":
+                    region = resolved_reg
+            except (ImportError, Exception) as exc:  # health: allow BLE001 -- probe fallback
+                logger.debug("Hermes vertex_adapter fallback: %s", exc)
+
+        # 2. Service Account JSON file path
+        if (not token or not project_id) and self._credentials_path and os.path.exists(self._credentials_path):
+            try:
+                with open(self._credentials_path, "r", encoding="utf-8-sig") as f:
+                    sa_data = json.load(f)
+                    if not project_id and "project_id" in sa_data:
+                        project_id = sa_data["project_id"]
+            except Exception as e:  # health: allow BLE001 -- malformed JSON fallback
+                logger.debug("Failed reading service account JSON for project_id: %s", e)
+
+        # 3. Environment variables
+        if not project_id:
+            project_id = (
+                os.environ.get("GOOGLE_CLOUD_PROJECT")
+                or os.environ.get("GCP_PROJECT")
+                or os.environ.get("VERTEX_PROJECT_ID")
+            )
+
+        # 4. google.auth ADC fallback
+        if not token:
+            try:
+                import google.auth
+                import google.auth.transport.requests
+                creds, default_proj = google.auth.default(
+                    scopes=["https://www.googleapis.com/auth/cloud-platform"]
+                )
+                if not project_id:
+                    project_id = default_proj
+                req = google.auth.transport.requests.Request()
+                creds.refresh(req)
+                token = creds.token
+            except Exception as e:  # health: allow BLE001 -- ADC probe fallback
+                logger.debug("google.auth ADC resolution failed: %s", e)
+
+        # 5. gcloud CLI fallback
+        if not token:
+            try:
+                proc = subprocess.run(
+                    ["gcloud", "auth", "print-access-token"],
+                    capture_output=True,
+                    text=True,
+                    timeout=10,
+                    check=False,
+                    encoding="utf-8",
+                    errors="replace",
+                )
+                if proc.returncode == 0 and proc.stdout.strip():
+                    token = proc.stdout.strip()
+            except Exception as e:  # health: allow BLE001 -- CLI probe fallback
+                logger.debug("gcloud CLI token resolution failed: %s", e)
+
+        if not token:
+            raise VertexMediaAuthError(
+                "Unable to obtain Google Cloud OAuth2 token. Configure GOOGLE_APPLICATION_CREDENTIALS, "
+                "VERTEX_BEARER_TOKEN, or run 'gcloud auth application-default login'."
+            )
+        if not project_id:
+            raise VertexMediaAuthError(
+                "Google Cloud Project ID is not resolved. Set GOOGLE_CLOUD_PROJECT, "
+                "or configure vertex.project_id in config.yaml."
+            )
+
+        if not region or region == "global":
+            region = DEFAULT_REGION
+
+        return token, project_id, region
+
+    def _headers(self, token: str) -> dict[str, str]:
+        return {
+            "Authorization": f"Bearer {token}",
+            "Content-Type": "application/json; charset=utf-8",
+            "User-Agent": "DNK-VertexMedia/1.0.0",
+        }
+
+    def _get_http_client(self):
+        try:
+            import httpx
+            return httpx.Client(timeout=180.0)
+        except ImportError:
+            import urllib.request
+            return None
+
+    def _send_request(self, method: str, url: str, headers: dict[str, str], payload: dict | None = None) -> dict:
+        """Execute HTTP request using httpx or fallback standard library."""
+        try:
+            import httpx
+            with httpx.Client(timeout=180.0) as client:
+                res = client.request(method=method, url=url, headers=headers, json=payload)
+                if res.status_code >= 400:
+                    raise VertexMediaAPIError(
+                        f"Vertex AI API error [{res.status_code}]: {res.text}",
+                        status_code=res.status_code,
+                        details=res.text,
+                    )
+                return res.json()
+        except ImportError:
+            import urllib.error
+            import urllib.request
+            req_data = json.dumps(payload).encode("utf-8") if payload is not None else None
+            req = urllib.request.Request(url, data=req_data, headers=headers, method=method)
+            try:
+                with urllib.request.urlopen(req, timeout=180.0) as resp:
+                    return json.loads(resp.read().decode("utf-8"))
+            except urllib.error.HTTPError as he:
+                err_text = he.read().decode("utf-8", errors="replace")
+                raise VertexMediaAPIError(
+                    f"Vertex AI API error [{he.code}]: {err_text}",
+                    status_code=he.code,
+                    details=err_text,
+                )
+
+    # -------------------------------------------------------------------------
+    # Image Generation (Imagen 3 / 4)
+    # -------------------------------------------------------------------------
+    def generate_image(
+        self,
+        prompt: str,
+        *,
+        model: str = DEFAULT_IMAGEN_MODEL,
+        aspect_ratio: str = "1:1",
+        number_of_images: int = 1,
+        person_generation: str = "ALLOW_ADULT",
+        safety_setting: str = "block_medium_and_above",
+        add_watermark: bool = True,
+        negative_prompt: str | None = None,
+    ) -> dict[str, Any]:
+        """Generate images using Google Cloud Vertex AI Imagen models.
+
+        Args:
+            prompt: Text prompt describing the desired image.
+            model: Imagen model ID (e.g. 'imagen-3.0-generate-002', 'imagen-4.0-generate-001').
+            aspect_ratio: '1:1', '16:9', '9:16', '4:3', '3:4'.
+            number_of_images: 1 to 4.
+            person_generation: 'ALLOW_ADULT', 'DONT_ALLOW', 'ALLOW_ALL'.
+            safety_setting: Content moderation filter level.
+            add_watermark: Embed SynthID digital watermark.
+            negative_prompt: Content to avoid.
+
+        Returns:
+            Dictionary with 'images' (list of saved file paths), 'model', 'prompt', 'aspect_ratio'.
+        """
+        token, project_id, region = self.resolve_credentials()
+        endpoint_url = (
+            f"https://{region}-aiplatform.googleapis.com/v1/projects/{project_id}/"
+            f"locations/{region}/publishers/google/models/{model}:predict"
+        )
+
+        parameters: dict[str, Any] = {
+            "sampleCount": min(max(1, number_of_images), 4),
+            "aspectRatio": aspect_ratio,
+            "personGeneration": person_generation,
+            "safetySetting": safety_setting,
+            "addWatermark": add_watermark,
+        }
+        if negative_prompt:
+            parameters["negativePrompt"] = negative_prompt
+
+        request_body = {
+            "instances": [{"prompt": prompt}],
+            "parameters": parameters,
+        }
+
+        resp_data = self._send_request("POST", endpoint_url, self._headers(token), request_body)
+        predictions = resp_data.get("predictions", [])
+        if not predictions:
+            raise VertexMediaAPIError(f"No image predictions returned by Vertex AI: {resp_data}")
+
+        out_dir = self._cache_dir / "images"
+        out_dir.mkdir(parents=True, exist_ok=True)
+
+        saved_files: list[str] = []
+        for idx, pred in enumerate(predictions):
+            b64_bytes = pred.get("bytesBase64Encoded")
+            mime_type = pred.get("mimeType", "image/jpeg")
+            ext = "png" if "png" in mime_type else "jpg"
+            if not b64_bytes:
+                continue
+
+            raw_bytes = base64.b64decode(b64_bytes)
+            timestamp = int(time.time() * 1000)
+            file_name = f"vertex_imagen_{timestamp}_{idx}.{ext}"
+            target_path = out_dir / file_name
+            target_path.write_bytes(raw_bytes)
+            saved_files.append(str(target_path.resolve()))
+
+        return {
+            "success": True,
+            "images": saved_files,
+            "image": saved_files[0] if saved_files else "",
+            "model": model,
+            "prompt": prompt,
+            "aspect_ratio": aspect_ratio,
+            "provider": "vertex",
+            "metadata": {"predictions_count": len(predictions)},
+        }
+
+    # -------------------------------------------------------------------------
+    # Video Generation (Google Veo 3.1)
+    # -------------------------------------------------------------------------
+    def generate_video(
+        self,
+        prompt: str,
+        *,
+        model: str = DEFAULT_VEO_MODEL,
+        image_url: str | None = None,
+        aspect_ratio: str = "16:9",
+        resolution: str = "720p",
+        duration_seconds: int = 6,
+        person_generation: str = "ALLOW_ADULT",
+        generate_audio: bool = True,
+        negative_prompt: str | None = None,
+        poll_interval_s: float = 12.0,
+        max_wait_s: float = 240.0,
+    ) -> dict[str, Any]:
+        """Generate videos using Google Cloud Vertex AI Veo models via LRO polling.
+
+        Args:
+            prompt: Text prompt describing the scene and camera direction.
+            model: Veo model ID (e.g. 'veo-3.1-generate-001', 'veo-3.1-fast-generate-001').
+            image_url: Optional initial image path or URL for Image-to-Video.
+            aspect_ratio: '16:9' or '9:16'.
+            resolution: '720p', '1080p', or '4k'.
+            duration_seconds: 4, 6, or 8 seconds.
+            person_generation: 'ALLOW_ADULT' or 'DONT_ALLOW'.
+            generate_audio: Synthesize synchronized sound & atmosphere.
+            negative_prompt: Content to avoid.
+            poll_interval_s: Polling interval in seconds.
+            max_wait_s: Maximum operation timeout.
+
+        Returns:
+            Dictionary with 'video' (path to saved mp4), 'model', 'prompt', 'duration', 'success'.
+        """
+        token, project_id, region = self.resolve_credentials()
+        endpoint_url = (
+            f"https://{region}-aiplatform.googleapis.com/v1/projects/{project_id}/"
+            f"locations/{region}/publishers/google/models/{model}:predictLongRunning"
+        )
+
+        instance: dict[str, Any] = {"prompt": prompt}
+
+        # Handle reference image if provided (Image-to-Video)
+        if image_url:
+            img_b64 = self._load_image_base64(image_url)
+            if img_b64:
+                instance["image"] = {"bytesBase64Encoded": img_b64}
+
+        # Normalize duration (Veo 3.1 accepts 4, 6, 8)
+        valid_durations = [4, 6, 8]
+        duration = min(valid_durations, key=lambda d: abs(d - duration_seconds))
+
+        parameters: dict[str, Any] = {
+            "aspectRatio": aspect_ratio if aspect_ratio in ("16:9", "9:16") else "16:9",
+            "resolution": resolution if resolution in ("720p", "1080p", "4k") else "720p",
+            "durationSeconds": duration,
+            "personGeneration": person_generation,
+            "generateAudio": generate_audio,
+            "sampleCount": 1,
+        }
+        if negative_prompt:
+            parameters["negativePrompt"] = negative_prompt
+
+        request_body = {
+            "instances": [instance],
+            "parameters": parameters,
+        }
+
+        # 1. Start Long Running Operation
+        start_resp = self._send_request("POST", endpoint_url, self._headers(token), request_body)
+        operation_name = start_resp.get("name")
+        if not operation_name:
+            raise VertexMediaAPIError(f"Failed to initiate Veo video generation: {start_resp}")
+
+        logger.info("Vertex Veo video generation operation started: %s", operation_name)
+
+        # 2. Poll until completion
+        op_url = f"https://{region}-aiplatform.googleapis.com/v1/{operation_name}"
+        elapsed = 0.0
+        start_time = time.time()
+
+        while elapsed < max_wait_s:
+            time.sleep(poll_interval_s)
+            elapsed = time.time() - start_time
+
+            # Refresh token if long-running
+            token, _, _ = self.resolve_credentials()
+            op_data = self._send_request("GET", op_url, self._headers(token))
+
+            if op_data.get("done"):
+                if "error" in op_data:
+                    raise VertexMediaAPIError(
+                        f"Veo video generation failed: {op_data['error']}",
+                        details=op_data["error"]
+                    )
+
+                response_content = op_data.get("response", {})
+                gen_videos = response_content.get("generatedVideos", [])
+                if not gen_videos:
+                    raise VertexMediaAPIError(f"Operation done but generatedVideos is empty: {op_data}")
+
+                video_item = gen_videos[0].get("video", {})
+                b64_video = video_item.get("bytesBase64Encoded")
+                video_uri = video_item.get("uri")
+
+                out_dir = self._cache_dir / "videos"
+                out_dir.mkdir(parents=True, exist_ok=True)
+                timestamp = int(time.time() * 1000)
+                out_path = out_dir / f"vertex_veo_{timestamp}.mp4"
+
+                if b64_video:
+                    out_path.write_bytes(base64.b64decode(b64_video))
+                elif video_uri:
+                    # Download from Google Cloud Storage or mirror URI
+                    self._download_gcs_or_url(video_uri, out_path, token)
+                else:
+                    raise VertexMediaAPIError(f"No video bytes or URI in operation response: {video_item}")
+
+                return {
+                    "success": True,
+                    "video": str(out_path.resolve()),
+                    "model": model,
+                    "prompt": prompt,
+                    "modality": "image" if image_url else "text",
+                    "aspect_ratio": aspect_ratio,
+                    "duration": duration,
+                    "provider": "vertex",
+                    "metadata": {"operation_name": operation_name, "elapsed_seconds": round(elapsed, 1)},
+                }
+
+        raise VertexMediaAPIError(f"Timed out waiting for Veo video generation after {max_wait_s}s.")
+
+    def _load_image_base64(self, path_or_url: str) -> Optional[str]:
+        """Load image bytes into Base64 from local file or HTTP URL."""
+        try:
+            if path_or_url.startswith(("http://", "https://")):
+                import httpx
+                with httpx.Client(timeout=30.0) as client:
+                    resp = client.get(path_or_url)
+                    if resp.status_code == 200:
+                        return base64.b64encode(resp.content).decode("utf-8")
+            else:
+                p = Path(path_or_url).expanduser()
+                if p.exists() and p.is_file():
+                    return base64.b64encode(p.read_bytes()).decode("utf-8")
+        except Exception as e:  # health: allow BLE001 -- reference image load fallback
+            logger.warning("Failed to load reference image '%s': %s", path_or_url, e)
+        return None
+
+    def _download_gcs_or_url(self, uri: str, target: Path, token: str) -> None:
+        """Download file from GCS or HTTPS URI."""
+        try:
+            import httpx
+            headers = {"Authorization": f"Bearer {token}"}
+            with httpx.Client(timeout=120.0) as client:
+                r = client.get(uri, headers=headers)
+                r.raise_for_status()
+                target.write_bytes(r.content)
+        except Exception as e:
+            logger.error("Failed downloading video from %s: %s", uri, e)
+            raise
