+
+from __future__ import annotations
+
+import logging
+from typing import Any, Dict, List, Optional
+
+from agent.image_gen_provider import (
+    DEFAULT_ASPECT_RATIO,
+    ImageGenProvider,
+    error_response,
+    resolve_aspect_ratio,
+    success_response,
+)
+try:
+    from .client import (
+        DEFAULT_IMAGEN_MODEL,
+        VertexMediaAPIError,
+        VertexMediaAuthError,
+        VertexMediaClient,
+    )
+except (ImportError, ValueError):
+    from client import (  # type: ignore
+        DEFAULT_IMAGEN_MODEL,
+        VertexMediaAPIError,
+        VertexMediaAuthError,
+        VertexMediaClient,
+    )
+
+logger = logging.getLogger("hermes.plugins.vertex_media.image_provider")
+
+_ASPECT_RATIO_MAP = {
+    "landscape": "16:9",
+    "square": "1:1",
+    "portrait": "9:16",
+}
+
+
+class GoogleVertexImageGenProvider(ImageGenProvider):
+    """Google Vertex AI (Imagen 3 / 4) image generation backend for Hermes."""
+
+    def __init__(self, client: Optional[VertexMediaClient] = None) -> None:
+        self._client = client or VertexMediaClient()
+
+    @property
+    def name(self) -> str:
+        return "vertex"
+
+    @property
+    def display_name(self) -> str:
+        return "Google Vertex AI (Imagen)"
+
+    def is_available(self) -> bool:
+        """Check if Vertex AI credentials or project are present."""
+        try:
+            from agent.vertex_adapter import has_vertex_credentials
+            if has_vertex_credentials():
+                return True
+        except (ImportError, KeyError, AttributeError, OSError):
+            pass
+
+        import os
+        return bool(
+            os.environ.get("GOOGLE_APPLICATION_CREDENTIALS")
+            or os.environ.get("VERTEX_BEARER_TOKEN")
+            or os.environ.get("GOOGLE_CLOUD_PROJECT")
+            or os.environ.get("GCP_PROJECT")
+        )
+
+    def list_models(self) -> list[dict[str, Any]]:
+        return [
+            {
+                "id": "imagen-3.0-generate-002",
+                "display": "Imagen 3 (Standard SOTA)",
+                "speed": "~5-8s",
+                "strengths": "Photorealism, typography, high prompt adherence",
+            },
+            {
+                "id": "imagen-4.0-generate-001",
+                "display": "Imagen 4 Preview",
+                "speed": "~4-7s",
+                "strengths": "Next-gen aesthetics, rich lighting, 2K outputs",
+            },
+            {
+                "id": "imagen-4.0-fast-generate-001",
+                "display": "Imagen 4 Fast",
+                "speed": "~2-4s",
+                "strengths": "Ultra-low latency generation for rapid iterations",
+            },
+        ]
+
+    def default_model(self) -> Optional[str]:
+        return DEFAULT_IMAGEN_MODEL
+
+    def capabilities(self) -> dict[str, Any]:
+        return {
+            "modalities": ["text"],
+            "max_reference_images": 0,
+            "creative_controls": ["resolution"],
+        }
+
+    def generate(
+        self,
+        prompt: str,
+        aspect_ratio: str = DEFAULT_ASPECT_RATIO,
+        *,
+        image_url: Optional[str] = None,
+        reference_image_urls: Optional[list[str]] = None,
+        model: Optional[str] = None,
+        **kwargs: Any,
+    ) -> dict[str, Any]:
+        resolved_ratio_key = resolve_aspect_ratio(aspect_ratio)
+        api_aspect_ratio = _ASPECT_RATIO_MAP.get(resolved_ratio_key, "1:1")
+        target_model = model or DEFAULT_IMAGEN_MODEL
+
+        try:
+            result = self._client.generate_image(
+                prompt=prompt,
+                model=target_model,
+                aspect_ratio=api_aspect_ratio,
+                number_of_images=1,
+            )
+            return success_response(
+                image=result["image"],
+                model=result["model"],
+                prompt=result["prompt"],
+                aspect_ratio=resolved_ratio_key,
+                provider=self.name,
+                modality="text",
+                extra={"images": result["images"], "api_aspect_ratio": api_aspect_ratio},
+            )
+        except VertexMediaAuthError as e:
+            return error_response(
+                prompt=prompt,
+                model=target_model,
+                provider=self.name,
+                error=f"Google Vertex AI authentication error: {e}",
+                error_type="auth_error",
+            )
+        except VertexMediaAPIError as e:
+            return error_response(
+                prompt=prompt,
+                model=target_model,
+                provider=self.name,
+                error=f"Google Vertex AI API error: {e}",
+                error_type="api_error",
+            )
+        except Exception as e:
+            logger.exception("Unexpected error in Vertex image generation")
+            return error_response(
+                prompt=prompt,
+                model=target_model,
+                provider=self.name,
+                error=f"Unexpected error: {e}",
+                error_type="internal_error",
+            )
