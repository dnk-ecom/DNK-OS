 class TestWriteToSandbox:
diff --git a/tools/tool_result_storage.py b/tools/tool_result_storage.py
index 39407dc51af..d79403b243b 100644
--- a/tools/tool_result_storage.py
+++ b/tools/tool_result_storage.py
@@ -271,10 +271,28 @@ def _safe_result_filename(tool_use_id: str) -> str:
     return f"{safe_stem}.txt"
 
 
-def generate_preview(content: str, max_chars: int = DEFAULT_PREVIEW_SIZE_CHARS) -> tuple[str, bool]:
-    """Truncate at last newline within max_chars. Returns (preview, has_more)."""
+def generate_preview(content: str, max_chars: int = DEFAULT_PREVIEW_SIZE_CHARS, *, balanced: bool = True) -> tuple[str, bool]:
+    """Digest large content within max_chars. Returns (preview, has_more).
+    When balanced=True and max_chars is substantial, produces a balanced head/tail digest
+    with line/byte elision counts so neither setup nor trailing error logs/exit statuses are lost."""
     if len(content) <= max_chars:
         return content, False
+    if balanced and max_chars >= 500 and len(content) > max_chars:
+        head_budget = int(max_chars * 0.45)
+        tail_budget = int(max_chars * 0.45)
+        head_nl = content.rfind("\n", 0, head_budget)
+        head_end = head_nl + 1 if head_nl > head_budget // 3 else head_budget
+        tail_start = len(content) - tail_budget
+        tail_nl = content.find("\n", tail_start)
+        if tail_nl != -1 and tail_nl < tail_start + (tail_budget // 3):
+            tail_start = tail_nl + 1
+        head_part = content[:head_end]
+        tail_part = content[tail_start:]
+        elided_chars = len(content) - len(head_part) - len(tail_part)
+        elided_lines = content[head_end:tail_start].count("\n")
+        marker = f"\n\n... [{elided_lines:,} lines, {elided_chars:,} chars elided] ...\n\n"
+        return f"{head_part}{marker}{tail_part}", True
+
     last_nl = content.rfind("\n", 0, max_chars)
     return content[:last_nl + 1 if last_nl > max_chars // 2 else max_chars], True
 
