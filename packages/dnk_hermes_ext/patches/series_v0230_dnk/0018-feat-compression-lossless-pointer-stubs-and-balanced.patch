+def test_summarize_tool_result_preserves_lossless_archive_pointers():
+    from agent.context_compressor import _summarize_tool_result
+    persisted_content = (
+        "<persisted-output>\n"
+        "This tool result was too large (50,000 characters).\n"
+        "Full output saved to: /home/user/.hermes/cache/spillover/call_123.txt\n"
+        "Preview:\nsome output\n"
+        "</persisted-output>"
+    )
+    summary = _summarize_tool_result("terminal", '{"command": "pytest"}', persisted_content)
+    assert "[archive: /home/user/.hermes/cache/spillover/call_123.txt]" in summary
+
+    terminal_json = '{"output": "trace...", "exit_code": 1, "full_output_path": "/home/user/.hermes/cache/terminal-output/out-1.log"}'
+    summary2 = _summarize_tool_result("terminal", '{"command": "make test"}', terminal_json)
+    assert "[archive: /home/user/.hermes/cache/terminal-output/out-1.log]" in summary2
