--- a/agent/context_compressor.py
+++ b/agent/context_compressor.py
@@ -840,7 +840,7 @@ _PRUNED_TOOL_PLACEHOLDER = "[Old tool output cleared to save context space]"
 
 def _is_summary_stub(content: str) -> bool:
     """True for a ``[tool] ... (N chars)`` summary (a prune-only one may carry the rule) or a lean-tail demotion stub."""
-    return (s := without_skill_safety_rule(content)).startswith("[") and " chars)" in s and len(s) < 400 or is_demoted_stub(s)
+    return (s := without_skill_safety_rule(content)).startswith("[") and (" chars)" in s or " lines output" in s or "[archive:" in s) and len(s) < 600 or is_demoted_stub(s)
 
 
 # Shared floor; the clarify summary cap must stay strictly BELOW it so a preserved
@@ -2019,9 +2019,23 @@ def _summarize_tool_result_unguarded(tool_name: str, tool_args: str, tool_conten
     line_count = content.count("\n") + 1 if content.strip() else 0
     summarizer = _TOOL_RESULT_SUMMARIZERS.get(tool_name)
     if summarizer is not None:
-        return summarizer(tool_name, args, content, content_len, line_count)
-    first_arg = "".join(f" {k}={str(v)[:40]}" for k, v in list(args.items())[:2])
-    return f"[{tool_name}]{first_arg} ({content_len:,} chars result)" + _result_failure_suffix(content)
+        base = summarizer(tool_name, args, content, content_len, line_count)
+    else:
+        first_arg = "".join(f" {k}={str(v)[:40]}" for k, v in list(args.items())[:2])
+        base = f"[{tool_name}]{first_arg} ({content_len:,} chars result)" + _result_failure_suffix(content)
+
+    # Lossless pointer stub: preserve spillover or full_output_path pointer across compaction
+    archive_path = None
+    if "<persisted-output>" in content:
+        from tools.tool_result_storage import extract_persisted_path
+        archive_path = extract_persisted_path(content)
+    elif "full_output_path" in content:
+        m = re.search(r'"full_output_path"\s*:\s*"([^"]+)"', content)
+        if m:
+            archive_path = m.group(1).replace("\\\\", "/")
+    if archive_path and f"[archive: {archive_path}]" not in base:
+        base += f" [archive: {archive_path}]"
+    return base
 
 
