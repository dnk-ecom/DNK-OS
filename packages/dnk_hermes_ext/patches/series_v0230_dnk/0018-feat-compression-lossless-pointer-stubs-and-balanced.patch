+    def test_balanced_digest_preserves_head_and_tail(self):
+        lines = ["header start"] + [f"row {i}" for i in range(500)] + ["footer end with error code 1"]
+        content = "\n".join(lines)
+        preview, has_more = generate_preview(content, max_chars=800, balanced=True)
