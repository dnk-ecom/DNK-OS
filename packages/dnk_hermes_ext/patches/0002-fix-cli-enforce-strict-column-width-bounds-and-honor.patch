From eaa497a7a1dc1527845fb0e3b6026c27334d3550 Mon Sep 17 00:00:00 2001
From: Kuzmenko-top <reburn.craft@gmail.com>
Date: Fri, 6 Nov 2026 19:48:30 +0200
Subject: [PATCH 2/5] fix(cli): enforce strict column width bounds and honor
 empty banner_logo in skins

---
 hermes_cli/banner.py | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/banner.py b/hermes_cli/banner.py
index e324f66e5f..ac5cef8e04 100644
--- a/hermes_cli/banner.py
+++ b/hermes_cli/banner.py
@@ -760,7 +760,13 @@ def build_welcome_banner(
         layout_table, title=f"[bold {_skin_color('banner_title', '#FFD700')}]{version_label}[/]",
         border_style=_skin_color("banner_border", "#CD7F32"), padding=(0, 2))
     console.print()
-    if shutil.get_terminal_size().columns >= 95:
-        console.print(getattr(_bskin, "banner_logo", None) or HERMES_AGENT_LOGO)
-        console.print()
+    logo = getattr(_bskin, "banner_logo", None)
+    if logo is None:
+        logo = HERMES_AGENT_LOGO
+    if logo:
+        raw_lines = [re.sub(r'\[.*?\]', '', line) for line in logo.strip().splitlines()]
+        req_width = max(len(line) for line in raw_lines) if raw_lines else 0
+        if shutil.get_terminal_size().columns >= req_width + 4:
+            console.print(logo)
+            console.print()
     console.print(outer_panel)
-- 
2.50.1

